load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The presentation stylesheets: cpe-server embeds them, cpe-web's tests read them.
filegroup(
    name = "style",
    srcs = glob(["style/**"]),
    visibility = [
        "//areas/access/cpe/server:__pkg__",
        "//areas/access/cpe/web:__pkg__",
    ],
)

rust_library(
    name = "cpe_components",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "cpe_components",
    visibility = [
        "//areas/access/cpe/server:__pkg__",
        "//areas/access/cpe/web:__pkg__",
    ],
    deps = [
        "//areas/access/cpe/core:cpe_core",
        "//areas/access/cpe/image-viewer:cpe_image_viewer",
        "//shared/datastar:shared_datastar",
        "@crates//:maud",
        "@crates//:pulldown-cmark",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "cpe_components_test",
    crate = ":cpe_components",
    compile_data = glob(["src/**/testdata/**"]),
    data = glob(["src/**/snapshots/**"]),
    deps = ["@crates//:insta"],
)
