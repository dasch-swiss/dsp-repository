const at = (() => { try { return document.getElementById(decodeURIComponent(location.hash.slice(1))); } catch { return null; } })()?.closest('#annotations .anno__entry'); if (at) { if (!at.classList.contains('anno__entry--page')) $_annoArrive = at.id.slice('annotation-'.length); const nav = performance.getEntriesByType('navigation')[0]; const ref = nav?.type === 'navigate' && document.referrer ? new URL(document.referrer) : null; if (ref?.origin === location.origin) { const page = ref.searchParams.get('page'); const from = [...at.querySelectorAll('a[data-anno-page]')].find((a) => new URL(a.href).pathname === ref.pathname && (page === null ? 'annoFirst' in a.dataset : page === a.dataset.annoPage)); if (from) $_annoNote = from.dataset.annoNote ?? ''; } if (nav?.type === 'navigate') requestAnimationFrame(() => { const reader = document.getElementById('compound-viewer'); const tracks = el.querySelector('.record__tracks'); if (reader && getComputedStyle(reader).position === 'sticky') at.scrollIntoView({block: 'end'}); else if (tracks && getComputedStyle(tracks).gridTemplateColumns.split(' ').length === 1) document.getElementById('cv-title')?.parentElement?.scrollIntoView({block: 'start'}); }); }
