<div id="cv-annotations"><section class="anno" id="annotations" aria-labelledby="anno-cap" data-on:keydown="if (evt.key === 'Escape') { if ($_annoPin &amp;&amp; !evt.target.closest('details[open]') &amp;&amp; !document.querySelector('#crumb-data[open]') &amp;&amp; !document.querySelector('.lang-menu[open]') &amp;&amp; !(m =&gt; m &amp;&amp; m.hidePopover &amp;&amp; m.matches(':popover-open'))(document.getElementById('header-menu'))) { $_annoPin = ''; document.querySelector('#compound-viewer image-viewer')?.goHome?.(); } return; }"><header class="anno__head"><div class="anno__title"><p class="eyebrow anno__of">Seite · 36 / 328</p><h3 class="anno__cap" id="anno-cap">Annotationen auf b4v</h3></div><button class="vctl anno__toggle" type="button" hidden aria-pressed="true" data-attr="{hidden: false, 'aria-pressed': $_annoShow ? 'true' : 'false'}" data-on:click="$_annoShow = !$_annoShow; $_annoNote = ''">Auf dem Scan zeigen</button></header><p class="anno__arrival" role="status" data-text="$_annoNote"></p><ol class="anno__list" role="list"><li class="anno__entry" id="annotation-w" style="--iv-c:#ff3333;--iv-on:#000" data-class="{'is-em': ($_annoPin || $_annoHover || $_annoArrive) === 'w'}" data-on:pointerenter="$_annoHover = 'w'" data-on:pointerleave="if ($_annoHover === 'w') $_annoHover = ''" data-on:focusin="$_annoHover = 'w'" data-on:focusout="if ($_annoHover === 'w') $_annoHover = ''"><button class="anno__chip" type="button" aria-pressed="false" aria-label="Annotation 1, Rechteck – auf dem Scan hervorheben" data-attr="{'aria-pressed': $_annoPin === 'w' ? 'true' : 'false'}" data-on:click="if ($_annoPin === 'w') { $_annoPin = ''; document.querySelector('#compound-viewer image-viewer')?.goHome?.(); } else { $_annoPin = 'w'; $_annoNote = ''; document.querySelector('#compound-viewer image-viewer')?.zoomToShape?.('w'); }">1</button><div class="anno__body"><p class="anno__shape">Rechteck <span class="anno__sep" aria-hidden="true">·</span> <span class="anno__swatch" aria-hidden="true"></span>Rot</p><p class="anno__remark" lang="de">Narr</p><div class="anno__links"><div class="anno__link anno__link--multi"><span class="anno__link-name" lang="de">identischer Holzschnitt</span><a class="anno__partner" href="/incunabula/books/narrenschiff-lat?page=lat-c3r#annotation-x1" data-anno-page="lat-c3r" data-anno-note="Von Narrenschiff (lat.) · c3r – Annotation 1 hervorgehoben."><em class="anno__book">Narrenschiff (lat.)</em> <span class="anno__page"><span aria-hidden="true">· </span>c3r</span> <span aria-hidden="true">→</span></a><a class="anno__partner" href="/incunabula/books/narrenschiff-lat?page=lat-m5r#annotation-x2" data-anno-page="lat-m5r" data-anno-note="Von Narrenschiff (lat.) · m5r – Annotation 1 hervorgehoben."><em class="anno__book">Narrenschiff (lat.)</em> <span class="anno__page"><span aria-hidden="true">· </span>m5r</span> <span aria-hidden="true">→</span></a><a class="anno__partner" href="/incunabula/books/narrenschiff-dt?page=narrenschiff-dt-o7v#annotation-x3" data-anno-page="narrenschiff-dt-o7v" data-anno-note="Von Das Narrenschiff · o7v – Annotation 1 hervorgehoben."><em class="anno__book">diese Ausgabe</em> <span class="anno__page"><span aria-hidden="true">· </span>o7v</span> <span aria-hidden="true">→</span></a></div></div></div></li></ol></section><div class="anno-bookmark"><div class="record__class"><p class="eyebrow">Buch</p><span class="record__id">narrenschiff-dt</span></div><p class="anno-bookmark__title">Das Narrenschiff</p></div></div>
