---
source: engine/src/component/annotation.rs
expression: render(&page)
---
<div id="cv-annotations"><section class="anno" id="annotations" aria-labelledby="anno-cap" data-on:keydown="if (evt.key === 'Escape') { if ($_annoPin &amp;&amp; !evt.target.closest('details[open]') &amp;&amp; !document.querySelector('#crumb-data[open]') &amp;&amp; !document.querySelector('.lang-menu[open]') &amp;&amp; !(m =&gt; m &amp;&amp; m.hidePopover &amp;&amp; m.matches(':popover-open'))(document.getElementById('header-menu'))) { $_annoPin = ''; document.querySelector('#compound-viewer image-viewer')?.goHome?.(); } return; }"><header class="anno__head"><div class="anno__title"><p class="eyebrow anno__of">Seite · 36 / 328</p><h3 class="anno__cap" id="anno-cap">Annotationen auf o6r</h3></div><button class="vctl anno__toggle" type="button" hidden aria-pressed="true" data-attr="{hidden: false, 'aria-pressed': $_annoShow ? 'true' : 'false'}" data-on:click="$_annoShow = !$_annoShow; $_annoNote = ''">Auf dem Scan zeigen</button></header><p class="anno__arrival" role="status" data-text="$_annoNote"></p><ol class="anno__list" role="list"><li class="anno__entry" id="annotation-rect" style="--iv-c:#ff3333;--iv-on:#000" data-class="{'is-em': ($_annoPin || $_annoHover || $_annoArrive) === 'rect'}" data-on:pointerenter="$_annoHover = 'rect'" data-on:pointerleave="if ($_annoHover === 'rect') $_annoHover = ''" data-on:focusin="$_annoHover = 'rect'" data-on:focusout="if ($_annoHover === 'rect') $_annoHover = ''"><button class="anno__chip" type="button" aria-pressed="false" aria-label="Annotation 1, Rechteck – auf dem Scan hervorheben" data-attr="{'aria-pressed': $_annoPin === 'rect' ? 'true' : 'false'}" data-on:click="if ($_annoPin === 'rect') { $_annoPin = ''; document.querySelector('#compound-viewer image-viewer')?.goHome?.(); } else { $_annoPin = 'rect'; $_annoNote = ''; document.querySelector('#compound-viewer image-viewer')?.zoomToShape?.('rect'); }">1</button><div class="anno__body"><p class="anno__shape">Rechteck <span class="anno__sep" aria-hidden="true">·</span> <span class="anno__swatch" aria-hidden="true"></span>Rot</p><p class="anno__remark" lang="de">Rot</p></div></li><li class="anno__entry" id="annotation-circle" style="--iv-c:#3333ff;--iv-on:#fff" data-class="{'is-em': ($_annoPin || $_annoHover || $_annoArrive) === 'circle'}" data-on:pointerenter="$_annoHover = 'circle'" data-on:pointerleave="if ($_annoHover === 'circle') $_annoHover = ''" data-on:focusin="$_annoHover = 'circle'" data-on:focusout="if ($_annoHover === 'circle') $_annoHover = ''"><button class="anno__chip" type="button" aria-pressed="false" aria-label="Annotation 2, Kreis – auf dem Scan hervorheben" data-attr="{'aria-pressed': $_annoPin === 'circle' ? 'true' : 'false'}" data-on:click="if ($_annoPin === 'circle') { $_annoPin = ''; document.querySelector('#compound-viewer image-viewer')?.goHome?.(); } else { $_annoPin = 'circle'; $_annoNote = ''; document.querySelector('#compound-viewer image-viewer')?.zoomToShape?.('circle'); }">2</button><div class="anno__body"><p class="anno__shape">Kreis <span class="anno__sep" aria-hidden="true">·</span> <span class="anno__swatch" aria-hidden="true"></span>Blau</p></div></li></ol></section><div class="anno-bookmark"><div class="record__class"><p class="eyebrow">Buch</p><span class="record__id">narrenschiff-dt</span></div><p class="anno-bookmark__title">Das Narrenschiff</p></div></div>
