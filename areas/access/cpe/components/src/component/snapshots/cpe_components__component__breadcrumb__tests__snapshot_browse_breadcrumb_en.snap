<nav class="breadcrumb" id="crumb-browse-characters" aria-label="Breadcrumb"><div class="breadcrumb__row"><a class="crumb-back" href="/alice-in-daschland/"><span class="visually-hidden">Back:</span> <span aria-hidden="true">‹</span><span class="crumb-back__label">Alice in DaSCHland</span></a><ol class="breadcrumb__list"><li class="breadcrumb__item"><a href="/">CPE</a></li><li class="breadcrumb__sep" aria-hidden="true">›</li><li class="breadcrumb__item"><a href="/alice-in-daschland/">Alice in DaSCHland</a></li><li class="breadcrumb__sep" aria-hidden="true">›</li><li class="breadcrumb__item breadcrumb__current" aria-current="page">Characters</li></ol><div class="crumb-actions"><div class="crumb-actions__row"><span class="crumb-share" data-signals="{copied:false}"><a class="crumb-share__link" id="share-browse-characters" href="https://example.com/alice-in-daschland/characters" title="Copy link to this view" aria-label="Copy link to this view" data-class="{'is-copied': $copied}" data-on:click__prevent="navigator.clipboard.writeText(el.href); $copied = true; setTimeout(() =&gt; { $copied = false }, 2400)"><span class="crumb-share__mark" aria-hidden="true"><span class="crumb-share__glyph"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" aria-hidden="true"><path d="M6.6 9.4 9.4 6.6"></path><path d="M7.6 4.6 8.9 3.3a2.4 2.4 0 0 1 3.4 3.4L11 8"></path><path d="M8.4 11.4 7.1 12.7a2.4 2.4 0 0 1-3.4-3.4L5 8"></path></svg></span><span class="crumb-share__dot"></span></span><span class="crumb-share__label crumb-label--long" data-text="$copied ? 'Copied' : 'Copy link'">Copy link</span><span class="crumb-share__label crumb-label--short" data-text="$copied ? 'Copied' : 'Copy'">Copy</span></a><span class="crumb-share__status" aria-live="polite" data-text="$copied ? 'Link to this view copied to the clipboard' : ''"></span></span></div></div></div></nav>
