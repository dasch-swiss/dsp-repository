<article class="compound-viewer compound-viewer--pages page" id="compound-viewer" tabindex="-1" aria-labelledby="cv-title" data-class="{'is-wide': $expand}" data-on:popstate__window="if (location.pathname + location.search !== window.__cpeReaderUrl) { location.reload(); }" data-on:keydown="if (evt.key !== 'ArrowLeft' &amp;&amp; evt.key !== 'ArrowRight') return; if (evt.repeat || evt.defaultPrevented || evt.shiftKey || evt.ctrlKey || evt.altKey || evt.metaKey) return; if (evt.target.closest('input,select,textarea,[contenteditable],[role=slider],details,image-viewer,.rv')) return; el.querySelector(evt.key === 'ArrowLeft' ? 'a[rel=prev]' : 'a[rel=next]')?.click();"><script>window.__cpeReaderUrl = location.pathname + location.search;</script><header class="cv-member__head"><p class="eyebrow cv-member__eyebrow">Page · 1 / 2</p><h2 class="cv-member__title" id="cv-title">a1r</h2><div class="cv-member__aside"><span class="cv-aside__text"><span aria-hidden="true">— </span>Title page.</span><details class="cv-aside__more"><summary><span class="cv-aside__open">more</span><span class="cv-aside__close">less</span></summary></details></div></header><div class="cv-status" id="cv-status" role="status" aria-live="polite"></div><div class="cv-stage"><div class="rv-unit" data-restricted="false"><div class="rv" data-signals="{rail:'closed', expand:false, plate:0, stripOpen:false, brightness:1, contrast:1, saturation:1, exposure:0, gamma:1, hue:0, invert:false}" data-class="{'rail-adjust': $rail === 'adjust', 'rail-details': $rail === 'details'}"><div class="rv__banner"><span class="rv__legal"><span class="rv__legal-plate"></span></span></div><div class="rv__canvas"><div class="rv__stand"><img src="https://example.org/scans/p1.jpg" alt="Folio a1r" decoding="async" loading="eager" fetchpriority="high"></div><div class="rv__rail rv__rail--details" id="rv-I_P1-details" role="region" aria-label="Details" data-attr="{'aria-hidden': $rail !== 'details' ? 'true' : 'false'}"><div class="rv__rail-head"><span>Details</span><button type="button" class="vctl" data-on:click="document.getElementById('rv-I_P1-details-toggle')?.focus({ preventScroll: true }); $rail = 'closed'" title="Close" aria-label="Close"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.3 4.3 11.7 11.7M11.7 4.3 4.3 11.7"></path></svg></button></div><div class="rv__rail-body"><div class="rv-details"><dl class="rf"><div class="rf__row"><dt>Identifier</dt><dd class="rf__mono">I_P1</dd></div><div class="rf__row"><dt>Dimensions</dt><dd class="rf__mono">1200 × 1800 px</dd></div><div class="rf__row"><dt>IIIF source</dt><dd class="rf__mono">https://example.org/scans/p1.jpg</dd></div></dl></div></div></div></div><div class="rv__bar"><div class="rv__ctrls"><button type="button" class="vctl" id="rv-I_P1-details-toggle" data-on:click="const open = $rail !== 'details'; $rail = open ? 'details' : 'closed'; if (open) setTimeout(() =&gt; document.getElementById('rv-I_P1-details')?.querySelector('.rv__rail-head .vctl')?.focus({ preventScroll: true }), 0)" data-attr="{'aria-pressed': $rail === 'details' ? 'true' : 'false'}" title="Details" aria-label="Details"><span>Details</span></button><button type="button" class="vctl vctl--icon vctl--wider" id="rv-I_P1-wider-toggle" data-on:click="$expand = !$expand" data-attr="{'aria-pressed': $expand ? 'true' : 'false'}" title="Wider view" aria-label="Wider view"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2.6H2.6V6M10 2.6h3.4V6M13.4 10v3.4H10M6 13.4H2.6V10"></path></svg></button></div></div></div></div></div><nav class="pg pg--reader" aria-label="Turn pages"><span class="pg__step" aria-disabled="true"><span aria-hidden="true">←</span> <span class="pg__word">Previous</span></span><span class="pg__count" aria-live="polite" aria-atomic="true">1 / 2</span><a class="pg__step" href="/incunabula/books/B1?page=P_002" rel="next" title="a1v" data-on:click__prevent="@get('/incunabula/books/B1/_compound?page=P_002')"><span class="pg__name