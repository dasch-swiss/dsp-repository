<article class="compound-viewer compound-viewer--pages page" id="compound-viewer" tabindex="-1" aria-labelledby="cv-title" data-class="{'is-wide': $expand}" data-on:popstate__window="if (location.pathname + location.search !== window.__cpeReaderUrl) { location.reload(); }" data-on:keydown="if (evt.key !== 'ArrowLeft' &amp;&amp; evt.key !== 'ArrowRight') return; if (evt.repeat || evt.defaultPrevented || evt.shiftKey || evt.ctrlKey || evt.altKey || evt.metaKey) return; if (evt.target.closest('input,select,textarea,[contenteditable],[role=slider],details,image-viewer,.rv')) return; el.querySelector(evt.key === 'ArrowLeft' ? 'a[rel=prev]' : 'a[rel=next]')?.click();"><script>window.__cpeReaderUrl = location.pathname + location.search;</script><div class="cv-toc"><nav class="cv-toc__contents" aria-label="Contents"><p class="cv-toc__cap">Contents · 3 parts</p><ol class="cv-toc__list"><li class="cv-toc__item"><a class="cv-toc__link" href="/incunabula/books/B1?page=P_001" data-on:click__prevent="@get('/incunabula/books/B1/_compound?page=P_001')"><span class="cv-toc__num">01</span><span>a1r</span></a></li><li class="cv-toc__item"><a class="cv-toc__link" href="/incunabula/books/B1?page=P_002" data-on:click__prevent="void 0" aria-current="page"><span class="cv-toc__num">02</span><span>a1v</span></a></li><li class="cv-toc__item"><a class="cv-toc__link" href="/incunabula/books/B1?page=P_003" data-on:click__prevent="@get('/incunabula/books/B1/_compound?page=P_003')"><span class="cv-toc__num">03</span><span>a2r</span></a></li></ol></nav><div class="cv-toc__reader"><header class="cv-member__head"><p class="eyebrow cv-member__eyebrow">Page · 2 / 3</p><h2 class="cv-member__title" id="cv-title">a1r</h2><div class="cv-member__aside"><span class="cv-aside__text"><span aria-hidden="true">— </span>Title page.</span><details class="cv-aside__more"><summary><span class="cv-aside__open">more</span><span class="cv-aside__close">less</span></summary></details></div></header><div class="cv-status" id="cv-status" role="status" aria-live="polite"></div><div class="cv-stage"><div class="rv-unit" data-restricted="false"><div class="rv" data-signals="{rail:'closed', expand:false, plate:0, stripOpen:false, brightness:1, contrast:1, saturation:1, exposure:0, gamma:1, hue:0, invert:false}" data-class="{'rail-adjust': $rail === 'adjust', 'rail-details': $rail === 'details'}"><div class="rv__banner"><span class="rv__legal"><span class="rv__legal-plate"><span class="em-legal__run">Test Library<span class="em-legal__dot"> · </span>CC BY 4.0</span></span></span></div><div class="rv__canvas" data-signals="{atHome: true, atNative: false, atMin: true, atMax: false, viewerError: false, scale: 'FIT'}" data-on:viewer-zoom="$scale = (evt.detail.atHome || evt.detail.ratioToHome == null) ? 'FIT' : ('×' + evt.detail.ratioToHome.toFixed(2) + (evt.detail.atNative ? ' · native' : '')); $atHome = evt.detail.atHome; $atNative = evt.detail.atNative; $atMin = evt.detail.atMin; $atMax = evt.detail.atMax" data-on:viewer-error="$viewerError = true"><image-viewer id="rv-I_P1" engine="osd-wc" tile-sources="[&quot;https://iiif.example.org/0803/p1.jpx/info.json&quot;]" auth-mode="none" label="Folio a1r" chrome="false"><img src="https://iiif.example.org/0803/p1.jpx/full/900,/0/default.jpg" alt="Folio a1r" decoding="async" loading="eager" fetchpriority="high"></image-viewer><div class="rv__rail rv__rail--details" id="rv-I_P1-details" role="region" aria-label="Details" data-attr="{'aria-hidden': $rail !== 'details' ? 'true' : 'false'}"><div class="rv__rail-head"><span>Details</span><button type="button" class="vctl" data-on:click="document.getElementById('rv-I_P1-details-toggle')?.focus({ preventScroll: true }); $rail = 'closed'" title="Close" aria-label="Close"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.3 4.3 11.7 11.7M11.7 4.3 4.3 11.7"></path></svg></button></div><div class="rv__rail-body"><div class="rv-details"><dl class="rf"><div class="rf__row"><dt>Identifier</dt><dd class="rf__mono">I_P1</dd></div><div class="rf__row"><dt>Dimensions</dt><dd class="rf__mono">1200 × 1800 px</dd></div><div class="rf__row"><dt>IIIF source</dt><dd class="rf__mono">https://iiif.example.org/0803/p1.jpx/full/max/0/default.jpg</dd></div></dl></div></div></div><div class="rv__rail rv__rail--adjust" id="rv-I_P1-adjust" role="region" aria-label="Adjust" data-attr="{'aria-hidden': $rail !== 'adjust' ? 'true' : 'false'}"><div class="rv__rail-head"><span>Adjust</span><button type="button" class="vctl" data-on:click="document.getElementById('rv-I_P1-adjust-toggle')?.focus({ preventScroll: true }); $rail = 'closed'" title="Close" aria-label="Close"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.3 4.3 11.7 11.7M11.7 4.3 4.3 11.7"></path></svg></button></div><div class="rv__rail-body"><div class="adj" data-class="{untouched: $brightness === 1}"><span class="adj__lbl">Brightness</span><span class="adj__val" data-text="$brightness.toFixed(2)">1.00</span><input class="adj__in" type="range" min="0.4" max="1.6" step="0.01" data-bind="brightness" aria-label="Brightness" data-on:input="document.getElementById('rv-I_P1').setBrightness($brightness * 100)"></div><div class="adj" data-class="{untouched: $contrast === 1}"><span class="adj__lbl">Contrast</span><span class="adj__val" data-text="$contrast.toFixed(2)">1.00</span><input class="adj__in" type="range" min="0.4" max="1.6" step="0.01" data-bind="contrast" aria-label="Contrast" data-on:input="document.getElementById('rv-I_P1').setContrast($contrast * 100)"></div><div class="adj" data-class="{untouched: $saturation === 1}"><span class="adj__lbl">Saturation</span><span class="adj__val" data-text="$saturation.toFixed(2)">1.00</span><input class="adj__in" type="range" min="0" max="2" step="0.01" data-bind="saturation" aria-label="Saturation" data-on:input="document.getElementById('rv-I_P1').setSaturation($saturation * 100)"></div><div class="adj" data-class="{untouched: $exposure === 0}"><span class="adj__lbl">Exposure</span><span class="adj__val" data-text="$exposure.toFixed(2)">0.00</span><input class="adj__in" type="range" min="-1" max="1" step="0.01" data-bind="exposure" aria-label="Exposure" data-on:input="document.getElementById('rv-I_P1').setExposure($exposure)"></div><div class="adj" data-class="{untouched: $gamma === 1}"><span class="adj__lbl">Gamma</span><span class="adj__val" data-text="$gamma.toFixed(2)">1.00</span><input class="adj__in" type="range" min="0.5" max="2" step="0.01" data-bind="gamma" aria-label="Gamma" data-on:input="document.getElementById('rv-I_P1').setGamma($gamma)"></div><div class="adj" data-class="{untouched: $hue === 0}"><span class="adj__lbl">Hue</span><span class="adj__val" data-text="$hue + '°'">0°</span><input class="adj__in" type="range" min="-180" max="180" step="1" data-bind="hue" aria-label="Hue" data-on:input="document.getElementById('rv-I_P1').setHue($hue)"></div><div class="adj adj--flag" data-class="{untouched: $invert === false}"><span class="adj__lbl">Invert</span><button type="button" class="vctl" data-attr="{'aria-pressed': $invert ? 'true' : 'false'}" data-on:click="$invert = !$invert; document.getElementById('rv-I_P1').setInvert($invert)">Invert</button></div><div class="rv__rail-note">Adjustments are a way of looking, not a setting: they carry across plates and are forgotten when you leave.</div></div><div class="rv__rail-foot"><button type="button" class="vctl" data-on:click="$brightness = 1; $contrast = 1; $saturation = 1; $exposure = 0; $gamma = 1; $hue = 0; $invert = false; document.getElementById('rv-I_P1').resetAdjust()">Reset all</button></div></div></div><div class="rv__bar"><span class="rv__err" aria-live="polite" aria-atomic="true" hidden data-attr="{'hidden': !$viewerError}">The zoomable image couldn't load.</span><div class="rv__ctrls"><span class="rv__scale" data-text="$scale">FIT</span><button type="button" class="vctl" id="rv-I_P1-details-toggle" data-on:click="const open = $rail !== 'details'; $rail = open ? 'details' : 'closed'; if (open) setTimeout(() =&gt; document.getElementById('rv-I_P1-details')?.querySelector('.rv__rail-head .vctl')?.focus({ preventScroll: true }), 0)" data-attr="{'aria-pressed': $rail === 'details' ? 'true' : 'false'}" title="Details" aria-label="Details"><span>Details</span></button><button type="button" class="vctl vctl--icon" id="rv-I_P1-adjust-toggle" data-on:click="const open = $rail !== 'adjust'; $rail = open ? 'adjust' : 'closed'; if (open) setTimeout(() =&gt; document.getElementById('rv-I_P1-adjust')?.querySelector('.rv__rail-head .vctl')?.focus({ preventScroll: true }), 0)" data-attr="{'aria-pressed': $rail === 'adjust' ? 'true' : 'false'}" title="Adjust" aria-label="Adjust"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4.3h11M2.5 8h11M2.5 11.7h11"></path><circle cx="10.4" cy="4.3" r="1.5"></circle><circle cx="5.6" cy="8" r="1.5"></circle><circle cx="11.4" cy="11.7" r="1.5"></circle></svg><span>Adjust</span></button><span class="vgroup"><button type="button" class="vctl vctl--icon" data-on:click="document.getElementById('rv-I_P1').zoomOut()" data-attr="{'aria-disabled': $atMin ? 'true' : 'false'}" title="Zoom out" aria-label="Zoom out"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.4 8h9.2"></path></svg></button><button type="button" class="vctl vctl--icon" data-on:click="document.getElementById('rv-I_P1').goHome()" data-attr="{'aria-disabled': $atHome ? 'true' : 'false'}" title="Fit to view" aria-label="Fit to view"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.6 7.3 8 2.9l5.4 4.4"></path><path d="M4.3 6.6V13h7.4V6.6"></path></svg></button><button type="button" class="vctl vctl--icon" data-on:click="document.getElementById('rv-I_P1').zoomIn()" data-attr="{'aria-disabled': $atMax ? 'true' : 'false'}" title="Zoom in" aria-label="Zoom in"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3.4V12.6M3.4 8h9.2"></path></svg></button></span><button type="button" class="vctl vctl--icon vctl--wider" id="rv-I_P1-wider-toggle" data-on:click="$expand = !$expand" data-attr="{'aria-pressed': $expand ? 'true' : 'false'}" title="Wider view" aria-label="Wider view"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2.6H2.6V6M10 2.6h3.4V6M13.4 10v3.4H10M6 13.4H2.6V10"></path></svg></button></div></div></div></div></div><nav class="pg pg--reader" aria-label="Turn pages"><a class="pg__step" href="/incunabula/books/B1?page=P_001" rel="prev" title="a1r" data-on:click__prevent="@get('/incunabula/books/B1/_compound?page=P_001')"><span aria-hidden="true">←</span> <span class="pg__word">Previous</span> <span class="pg__name"><span aria-hidden="true">· </span>a1r</span></a><span class="pg__count" aria-live="polite" aria-atomic="true">2 / 3</span><a class="pg__step" href="/incunabula/books/B1?page=P_003" rel="next" title="a2r" data-on:click__prevent="@get('/incunabula/books/B1/_compound?page=P_003')"><span class="pg__name">a2r<span aria-hidden="true"> ·</span></span> <span class="pg__word">Next</span> <span aria-hidden="true">→</span></a></nav></div></div></article>
