<div class="filterbar" id="filters-character-list" aria-live="polite" aria-atomic="true"><span class="filterbar__lbl">Filters</span><a class="filterchip" href="/alice-in-daschland/characters?lang=en&amp;keyword=K_002" data-on:click__prevent="@get('/alice-in-daschland/characters/_facets?lang=en&amp;keyword=K_002')" aria-label="Remove filter: Main character">Main character<span class="filterchip__x" aria-hidden="true">×</span></a><a class="filterchip" href="/alice-in-daschland/characters?lang=en&amp;role=R_01" data-on:click__prevent="@get('/alice-in-daschland/characters/_facets?lang=en&amp;role=R_01')" aria-label="Remove filter: Adventure">Adventure<span class="filterchip__x" aria-hidden="true">×</span></a><a class="filterbar__clear" href="/alice-in-daschland/characters?lang=en" data-on:click__prevent="@get('/alice-in-daschland/characters/_facets?lang=en')">Clear all</a></div>
