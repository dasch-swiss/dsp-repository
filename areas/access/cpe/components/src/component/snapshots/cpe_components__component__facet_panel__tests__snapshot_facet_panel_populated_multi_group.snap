<section class="facet-panel page" id="facets-character-list" aria-label="Filters"><details class="facet-panel__disclosure" open><summary class="facet-panel__toggle"><span class="facet-panel__toggle-label">Filters</span></summary><section class="facet-group"><div class="facet-group__titlerow"><h2 class="facet-group__title">Role</h2><a class="facet-group__clear" href="/alice-in-daschland/characters?lang=en&amp;keyword=K_002" data-on:click__prevent="@get('/alice-in-daschland/characters/_facets?lang=en&amp;keyword=K_002')">clear</a></div><ul class="facet-options"><li class="facet-option"><a class="facet-option__toggle" href="/alice-in-daschland/characters?lang=en&amp;keyword=K_002" data-on:click__prevent="@get('/alice-in-daschland/characters/_facets?lang=en&amp;keyword=K_002')" aria-current="true"><span class="facet-option__box" aria-hidden="true"></span><span class="facet-option__label">Main character</span><span class="facet-option__count">12</span></a></li><li class="facet-option"><a class="facet-option__toggle" href="/alice-in-daschland/characters?lang=en&amp;role=R_01&amp;keyword=K_002&amp;role=R_02" data-on:click__prevent="@get('/alice-in-daschland/characters/_facets?lang=en&amp;role=R_01&amp;keyword=K_002&amp;role=R_02')"><span class="facet-option__box" aria-hidden="true"></span><span class="facet-option__label">Secondary character</span><span class="facet-option__count">28</span></a></li><li class="facet-option"><a class="facet-option__toggle" href="/alice-in-daschland/characters?lang=en&amp;role=R_01&amp;keyword=K_002&amp;role=R_03" data-on:click__prevent="@get('/alice-in-daschland/characters/_facets?lang=en&amp;role=R_01&amp;keyword=K_002&amp;role=R_03')"><span class="facet-option__box" aria-hidden="true"></span><span class="facet-option__label">Minor character</span><span class="facet-option__count">14</span></a></li></ul></section><section class="facet-group"><div class="facet-group__titlerow"><h2 class="facet-group__title">Keyword</h2><a class="facet-group__clear" href="/alice-in-daschland/characters?lang=en&amp;role=R_01" data-on:click__prevent="@get('/alice-in-daschland/characters/_facets?lang=en&amp;role=R_01')">clear</a></div><ul class="facet-options"><li class="facet-option"><a class="facet-option__toggle" href="/alice-in-daschland/characters?lang=en&amp;role=R_01&amp;keyword=K_002&amp;keyword=K_001" data-on:click__prevent="@get('/alice-in-daschland/characters/_facets?lang=en&amp;role=R_01&amp;keyword=K_002&amp;keyword=K_001')"><span class="facet-option__box" aria-hidden="true"></span><span class="facet-option__label">Wonderland</span><span class="facet-option__count">18</span></a></li><li class="facet-option"><a class="facet-option__toggle" href="/alice-in-daschland/characters?lang=en&amp;role=R_01" data-on:click__prevent="@get('/alice-in-daschland/characters/_facets?lang=en&amp;role=R_01')" aria-current="true"><span class="facet-option__box" aria-hidden="true"></span><span class="facet-option__label">Adventure</span><span class="facet-option__count">22</span></a></li><li class="facet-option"><a class="facet-option__toggle" href="/alice-in-daschland/characters?lang=en&amp;role=R_01&amp;keyword=K_002&amp;keyword=K_003" data-on:click__prevent="@get('/alice-in-daschland/characters/_facets?lang=en&amp;role=R_01&amp;keyword=K_002&amp;keyword=K_003')"><span class="facet-option__box" aria-hidden="true"></span><span class="facet-option__label">Tea party</span><span class="facet-option__count">5</span></a></li></ul></section></details></section>
