<section class="facet-panel page" id="facets-location-list" aria-label="Filters"><details class="facet-panel__disclosure"><summary class="facet-panel__toggle"><span class="facet-panel__toggle-label">Filters</span></summary><section class="facet-group"><div class="facet-group__titlerow"><h2 class="facet-group__title">Location Type</h2></div><ul class="facet-options"><li class="facet-option"><a class="facet-option__toggle" href="/alice-in-daschland/locations?lang=en&amp;location-type=lt-wonderland" data-on:click__prevent="@get('/alice-in-daschland/locations/_facets?lang=en&amp;location-type=lt-wonderland')"><span class="facet-option__box" aria-hidden="true"></span><span class="facet-option__label">Wonderland</span><span class="facet-option__count">20</span></a></li><li class="facet-option"><a class="facet-option__toggle" href="/alice-in-daschland/locations?lang=en&amp;location-type=lt-real-world" data-on:click__prevent="@get('/alice-in-daschland/locations/_facets?lang=en&amp;location-type=lt-real-world')"><span class="facet-option__box" aria-hidden="true"></span><span class="facet-option__label">Real world</span><span class="facet-option__count">12</span></a></li></ul></section></details></section>
