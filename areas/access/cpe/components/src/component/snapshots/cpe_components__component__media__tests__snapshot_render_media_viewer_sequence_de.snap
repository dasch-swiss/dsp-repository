---
source: engine/src/component/media.rs
expression: out
---
<div id="record-figure" tabindex="-1" class="rv-col page"><div class="em-head"><div class="em-head__group"><span class="em-head__title">Illustrationen</span><span class="em-head__count">3</span></div></div><div class="rv-unit" data-restricted="false" data-class="{'is-restricted': [false,false,true][$plate]}"><div class="rv" data-signals="{rail:'closed', expand:false, plate:0, stripOpen:true, brightness:1, contrast:1, saturation:1, exposure:0, gamma:1, hue:0, invert:false}" data-class="{'rail-adjust': $rail === 'adjust', 'rail-details': $rail === 'details'}"><div class="rv__banner"><span class="rv__legal"><span class="rv__legal-plate" data-attr="{'hidden': $plate != 0}"></span><span class="rv__legal-plate" hidden data-attr="{'hidden': $plate != 1}"></span><span class="rv__legal-plate" hidden data-attr="{'hidden': $plate != 2}"><span class="em-access"><b>Eingeschränkte Ansicht — reduzierte Auflösung</b></span></span></span></div><div class="rv__canvas" data-signals="{atHome: true, atNative: false, atMin: true, atMax: false, viewerError: false, scale: 'FIT'}" data-on:viewer-zoom="$scale = (evt.detail.atHome || evt.detail.ratioToHome == null) ? 'FIT' : ('×' + evt.detail.ratioToHome.toFixed(2) + (evt.detail.atNative ? ' · native' : '')); $atHome = evt.detail.atHome; $atNative = evt.detail.atNative; $atMin = evt.detail.atMin; $atMax = evt.detail.atMax" data-on:viewer-error="$viewerError = true"><image-viewer id="rv-I_051" engine="osd-wc" tile-sources="[&quot;https://iiif.demo.dasch.swiss:443/0854/a.jpx/info.json&quot;,&quot;https://iiif.demo.dasch.swiss:443/0854/b.jpx/info.json&quot;,&quot;https://iiif.demo.dasch.swiss:443/0854/c.jpx/info.json&quot;]" auth-mode="none" sequence="true" label="An illustration" chrome="false" page="1"><img src="https://iiif.demo.dasch.swiss:443/0854/a.jpx/full/900,/0/default.jpg" alt="An illustration" decoding="async" loading="eager" fetchpriority="high"></image-viewer><div class="rv__rail rv__rail--details" id="rv-I_051-details" role="region" aria-label="Details" data-attr="{'aria-hidden': $rail !== 'details' ? 'true' : 'false'}"><div class="rv__rail-head"><span>Details</span><button type="button" class="vctl" data-on:click="document.getElementById('rv-I_051-details-toggle')?.focus({ preventScroll: true }); $rail = 'closed'" title="Schliessen" aria-label="Schliessen"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.3 4.3 11.7 11.7M11.7 4.3 4.3 11.7"></path></svg></button></div><div class="rv__rail-body"><div class="rv-details" data-attr="{'hidden': $plate != 0}"><dl class="rf"><div class="rf__row"><dt>Kennung</dt><dd class="rf__mono">I_051 · Tafel 1 von 3</dd></div><div class="rf__row"><dt>Abmessungen</dt><dd class="rf__mono">1000 × 1200 px</dd></div><div class="rf__row"><dt>IIIF-Quelle</dt><dd class="rf__mono">https://iiif.demo.dasch.swiss:443/0854/a.jpx/full/max/0/default.jpg</dd></div></dl></div><div class="rv-details" hidden data-attr="{'hidden': $plate != 1}"><dl class="rf"><div class="rf__row"><dt>Kennung</dt><dd class="rf__mono">I_052 · Tafel 2 von 3</dd></div><div class="rf__row"><dt>Abmessungen</dt><dd class="rf__mono">1000 × 1200 px</dd></div><div class="rf__row"><dt>IIIF-Quelle</dt><dd class="rf__mono">https://iiif.demo.dasch.swiss:443/0854/b.jpx/full/max/0/default.jpg</dd></div></dl></div><div class="rv-details" hidden data-attr="{'hidden': $plate != 2}"><dl class="rf"><div class="rf__row rf__row--access"><dt>Zugang</dt><dd>Dieses Bild wird in reduzierter Auflösung gezeigt, um eine lebende Person oder eine eingeschränkte Sammlung zu schützen.</dd></div><div class="rf__row"><dt>Kennung</dt><dd class="rf__mono">I_056 · Tafel 3 von 3</dd></div><div class="rf__row"><dt>Abmessungen</dt><dd class="rf__mono">1000 × 1200 px</dd></div><div class="rf__row"><dt>IIIF-Quelle</dt><dd class="rf__mono">https://iiif.demo.dasch.swiss:443/0854/c.jpx/full/max/0/default.jpg</dd></div></dl></div></div></div><div class="rv__rail rv__rail--adjust" id="rv-I_051-adjust" role="region" aria-label="Anpassen" data-attr="{'aria-hidden': $rail !== 'adjust' ? 'true' : 'false'}"><div class="rv__rail-head"><span>Anpassen</span><button type="button" class="vctl" data-on:click="document.getElementById('rv-I_051-adjust-toggle')?.focus({ preventScroll: true }); $rail = 'closed'" title="Schliessen" aria-label="Schliessen"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.3 4.3 11.7 11.7M11.7 4.3 4.3 11.7"></path></svg></button></div><div class="rv__rail-body"><div class="adj" data-class="{untouched: $brightness === 1}"><span class="adj__lbl">Helligkeit</span><span class="adj__val" data-text="$brightness.toFixed(2)">1.00</span><input class="adj__in" type="range" min="0.4" max="1.6" step="0.01" data-bind="brightness" aria-label="Helligkeit" data-on:input="document.getElementById('rv-I_051').setBrightness($brightness * 100)"></div><div class="adj" data-class="{untouched: $contrast === 1}"><span class="adj__lbl">Kontrast</span><span class="adj__val" data-text="$contrast.toFixed(2)">1.00</span><input class="adj__in" type="range" min="0.4" max="1.6" step="0.01" data-bind="contrast" aria-label="Kontrast" data-on:input="document.getElementById('rv-I_051').setContrast($contrast * 100)"></div><div class="adj" data-class="{untouched: $saturation === 1}"><span class="adj__lbl">Sättigung</span><span class="adj__val" data-text="$saturation.toFixed(2)">1.00</span><input class="adj__in" type="range" min="0" max="2" step="0.01" data-bind="saturation" aria-label="Sättigung" data-on:input="document.getElementById('rv-I_051').setSaturation($saturation * 100)"></div><div class="adj" data-class="{untouched: $exposure === 0}"><span class="adj__lbl">Belichtung</span><span class="adj__val" data-text="$exposure.toFixed(2)">0.00</span><input class="adj__in" type="range" min="-1" max="1" step="0.01" data-bind="exposure" aria-label="Belichtung" data-on:input="document.getElementById('rv-I_051').setExposure($exposure)"></div><div class="adj" data-class="{untouched: $gamma === 1}"><span class="adj__lbl">Gamma</span><span class="adj__val" data-text="$gamma.toFixed(2)">1.00</span><input class="adj__in" type="range" min="0.5" max="2" step="0.01" data-bind="gamma" aria-label="Gamma" data-on:input="document.getElementById('rv-I_051').setGamma($gamma)"></div><div class="adj" data-class="{untouched: $hue === 0}"><span class="adj__lbl">Farbton</span><span class="adj__val" data-text="$hue + '°'">0°</span><input class="adj__in" type="range" min="-180" max="180" step="1" data-bind="hue" aria-label="Farbton" data-on:input="document.getElementById('rv-I_051').setHue($hue)"></div><div class="adj adj--flag" data-class="{untouched: $invert === false}"><span class="adj__lbl">Invertieren</span><button type="button" class="vctl" data-attr="{'aria-pressed': $invert ? 'true' : 'false'}" data-on:click="$invert = !$invert; document.getElementById('rv-I_051').setInvert($invert)">Invertieren</button></div><div class="rv__rail-note">Anpassungen sind eine Art zu betrachten, keine Einstellung: Sie bleiben beim Blättern erhalten und werden beim Verlassen vergessen.</div></div><div class="rv__rail-foot"><button type="button" class="vctl" data-on:click="$brightness = 1; $contrast = 1; $saturation = 1; $exposure = 0; $gamma = 1; $hue = 0; $invert = false; document.getElementById('rv-I_051').resetAdjust()">Alles zurücksetzen</button></div></div></div><div class="rv__bar"><span class="rv__err" aria-live="polite" aria-atomic="true" hidden data-attr="{'hidden': !$viewerError}">Das zoombare Bild konnte nicht geladen werden.</span><div class="rv__ctrls"><span class="rv__scale" data-text="$scale">FIT</span><button type="button" class="vctl" id="rv-I_051-details-toggle" data-on:click="const open = $rail !== 'details'; $rail = open ? 'details' : 'closed'; if (open) setTimeout(() =&gt; document.getElementById('rv-I_051-details')?.querySelector('.rv__rail-head .vctl')?.focus({ preventScroll: true }), 0)" data-attr="{'aria-pressed': $rail === 'details' ? 'true' : 'false'}" title="Details" aria-label="Details"><span>Details</span></button><button type="button" class="vctl vctl--icon" id="rv-I_051-adjust-toggle" data-on:click="const open = $rail !== 'adjust'; $rail = open ? 'adjust' : 'closed'; if (open) setTimeout(() =&gt; document.getElementById('rv-I_051-adjust')?.querySelector('.rv__rail-head .vctl')?.focus({ preventScroll: true }), 0)" data-attr="{'aria-pressed': $rail === 'adjust' ? 'true' : 'false'}" title="Anpassen" aria-label="Anpassen"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4.3h11M2.5 8h11M2.5 11.7h11"></path><circle cx="10.4" cy="4.3" r="1.5"></circle><circle cx="5.6" cy="8" r="1.5"></circle><circle cx="11.4" cy="11.7" r="1.5"></circle></svg><span>Anpassen</span></button><span class="vgroup"><button type="button" class="vctl vctl--icon" data-on:click="document.getElementById('rv-I_051').zoomOut()" data-attr="{'aria-disabled': $atMin ? 'true' : 'false'}" title="Verkleinern" aria-label="Verkleinern"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.4 8h9.2"></path></svg></button><button type="button" class="vctl vctl--icon" data-on:click="document.getElementById('rv-I_051').goHome()" data-attr="{'aria-disabled': $atHome ? 'true' : 'false'}" title="An Ansicht anpassen" aria-label="An Ansicht anpassen"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.6 7.3 8 2.9l5.4 4.4"></path><path d="M4.3 6.6V13h7.4V6.6"></path></svg></button><button type="button" class="vctl vctl--icon" data-on:click="document.getElementById('rv-I_051').zoomIn()" data-attr="{'aria-disabled': $atMax ? 'true' : 'false'}" title="Vergrössern" aria-label="Vergrössern"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3.4V12.6M3.4 8h9.2"></path></svg></button></span><button type="button" class="vctl vctl--icon vctl--wider" id="rv-I_051-wider-toggle" data-on:click="$expand = !$expand" data-attr="{'aria-pressed': $expand ? 'true' : 'false'}" title="Breitere Ansicht" aria-label="Breitere Ansicht"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2.6H2.6V6M10 2.6h3.4V6M13.4 10v3.4H10M6 13.4H2.6V10"></path></svg></button></div></div></div></div><nav class="pg" aria-label="Bilder dieser Ressource"><a class="pg__step" href="/host?img=1#record-figure" aria-label="Vorheriges Bild" aria-disabled="true" data-attr="{'aria-disabled': $plate &lt;= 0 ? 'true' : 'false'}" data-on:click__prevent="if ($plate &gt; 0) { $plate = $plate - 1; document.getElementById('rv-I_051').goToPage($plate + 1); }">←</a><span class="pg__count" aria-live="polite" aria-atomic="true" data-text="($plate + 1) + ' / ' + 3">1 / 3</span><a class="pg__step" href="/host?img=2#record-figure" aria-label="Nächstes Bild" data-attr="{'aria-disabled': $plate &gt;= 2 ? 'true' : 'false'}" data-on:click__prevent="if ($plate &lt; 2) { $plate = $plate + 1; document.getElementById('rv-I_051').goToPage($plate + 1); }">→</a></nav><div class="em-col__meta" data-attr="{'hidden': $plate != 0}"></div><div class="em-col__meta" hidden data-attr="{'hidden': $plate != 1}"></div><div class="em-col__meta" hidden data-attr="{'hidden': $plate != 2}"></div><div class="em-col__strip"><a class="em-strip-toggle" href="/host?strip=0#record-figure" aria-expanded="true" data-attr="{'aria-expanded': $stripOpen ? 'true' : 'false'}" data-on:click__prevent="$stripOpen = !$stripOpen"><span class="em-strip-toggle__mark">▾</span><span data-text="$stripOpen ? &quot;Miniaturansichten ausblenden&quot; : &quot;Miniaturansichten anzeigen (3)&quot;">Miniaturansichten ausblenden</span></a><ul class="em-strip" data-attr="{'hidden': !$stripOpen}"><li><a class="em-thumb" href="/host?img=1#record-figure" aria-label="Tafel 1 von 3" data-restricted="false" aria-current="true" data-attr="{'aria-current': $plate == 0 ? 'true' : false}" data-on:click__prevent="$plate = 0; document.getElementById('rv-I_051').goToPage(1)"><img src="https://iiif.demo.dasch.swiss:443/0854/a.jpx/full/208,/0/default.jpg" alt="" loading="lazy"></a></li><li><a class="em-thumb" href="/host?img=2#record-figure" aria-label="Tafel 2 von 3" data-restricted="false" data-attr="{'aria-current': $plate == 1 ? 'true' : false}" data-on:click__prevent="$plate = 1; document.getElementById('rv-I_051').goToPage(2)"><img src="https://iiif.demo.dasch.swiss:443/0854/b.jpx/full/208,/0/default.jpg" alt="" loading="lazy"></a></li><li><a class="em-thumb" href="/host?img=3#record-figure" aria-label="Tafel 3 von 3" data-restricted="true" data-attr="{'aria-current': $plate == 2 ? 'true' : false}" data-on:click__prevent="$plate = 2; document.getElementById('rv-I_051').goToPage(3)"><img src="https://iiif.demo.dasch.swiss:443/0854/c.jpx/full/208,/0/default.jpg" alt="" loading="lazy"></a></li></ul></div></div>
