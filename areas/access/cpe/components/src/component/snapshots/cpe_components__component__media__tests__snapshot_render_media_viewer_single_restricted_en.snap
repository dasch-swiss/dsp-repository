---
source: engine/src/component/media.rs
expression: out
---
<div id="record-figure" tabindex="-1" class="rv-col page"><div class="em-head"><div class="em-head__group"><span class="em-head__title">Illustrations</span><span class="em-head__count">1</span></div></div><div class="rv-unit" data-restricted="true"><div class="rv" data-signals="{rail:'closed', expand:false, plate:0, stripOpen:false, brightness:1, contrast:1, saturation:1, exposure:0, gamma:1, hue:0, invert:false}" data-class="{'rail-adjust': $rail === 'adjust', 'rail-details': $rail === 'details'}"><div class="rv__banner"><span class="rv__legal"><span class="rv__legal-plate"><span class="em-access"><b>Restricted view — reduced resolution</b></span></span></span></div><div class="rv__canvas" data-signals="{atHome: true, atNative: false, atMin: true, atMax: false, viewerError: false, scale: 'FIT'}" data-on:viewer-zoom="$scale = (evt.detail.atHome || evt.detail.ratioToHome == null) ? 'FIT' : ('×' + evt.detail.ratioToHome.toFixed(2) + (evt.detail.atNative ? ' · native' : '')); $atHome = evt.detail.atHome; $atNative = evt.detail.atNative; $atMin = evt.detail.atMin; $atMax = evt.detail.atMax" data-on:viewer-error="$viewerError = true"><image-viewer id="rv-I_056" engine="osd-wc" tile-sources="[&quot;https://iiif.demo.dasch.swiss:443/0854/c.jpx/info.json&quot;]" auth-mode="none" label="An illustration" chrome="false"><img src="https://iiif.demo.dasch.swiss:443/0854/c.jpx/full/900,/0/default.jpg" alt="An illustration" decoding="async" loading="eager" fetchpriority="high"></image-viewer><div class="rv__rail rv__rail--details" id="rv-I_056-details" role="region" aria-label="Details" data-attr="{'aria-hidden': $rail !== 'details' ? 'true' : 'false'}"><div class="rv__rail-head"><span>Details</span><button type="button" class="vctl" data-on:click="document.getElementById('rv-I_056-details-toggle')?.focus({ preventScroll: true }); $rail = 'closed'" title="Close" aria-label="Close"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.3 4.3 11.7 11.7M11.7 4.3 4.3 11.7"></path></svg></button></div><div class="rv__rail-body"><div class="rv-details"><dl class="rf"><div class="rf__row rf__row--access"><dt>Access</dt><dd>This image is shown at reduced resolution to protect a living subject or restricted collection.</dd></div><div class="rf__row"><dt>Identifier</dt><dd class="rf__mono">I_056</dd></div><div class="rf__row"><dt>Dimensions</dt><dd class="rf__mono">1000 × 1200 px</dd></div><div class="rf__row"><dt>IIIF source</dt><dd class="rf__mono">https://iiif.demo.dasch.swiss:443/0854/c.jpx/full/max/0/default.jpg</dd></div></dl></div></div></div><div class="rv__rail rv__rail--adjust" id="rv-I_056-adjust" role="region" aria-label="Adjust" data-attr="{'aria-hidden': $rail !== 'adjust' ? 'true' : 'false'}"><div class="rv__rail-head"><span>Adjust</span><button type="button" class="vctl" data-on:click="document.getElementById('rv-I_056-adjust-toggle')?.focus({ preventScroll: true }); $rail = 'closed'" title="Close" aria-label="Close"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.3 4.3 11.7 11.7M11.7 4.3 4.3 11.7"></path></svg></button></div><div class="rv__rail-body"><div class="adj" data-class="{untouched: $brightness === 1}"><span class="adj__lbl">Brightness</span><span class="adj__val" data-text="$brightness.toFixed(2)">1.00</span><input class="adj__in" type="range" min="0.4" max="1.6" step="0.01" data-bind="brightness" aria-label="Brightness" data-on:input="document.getElementById('rv-I_056').setBrightness($brightness * 100)"></div><div class="adj" data-class="{untouched: $contrast === 1}"><span class="adj__lbl">Contrast</span><span class="adj__val" data-text="$contrast.toFixed(2)">1.00</span><input class="adj__in" type="range" min="0.4" max="1.6" step="0.01" data-bind="contrast" aria-label="Contrast" data-on:input="document.getElementById('rv-I_056').setContrast($contrast * 100)"></div><div class="adj" data-class="{untouched: $saturation === 1}"><span class="adj__lbl">Saturation</span><span class="adj__val" data-text="$saturation.toFixed(2)">1.00</span><input class="adj__in" type="range" min="0" max="2" step="0.01" data-bind="saturation" aria-label="Saturation" data-on:input="document.getElementById('rv-I_056').setSaturation($saturation * 100)"></div><div class="adj" data-class="{untouched: $exposure === 0}"><span class="adj__lbl">Exposure</span><span class="adj__val" data-text="$exposure.toFixed(2)">0.00</span><input class="adj__in" type="range" min="-1" max="1" step="0.01" data-bind="exposure" aria-label="Exposure" data-on:input="document.getElementById('rv-I_056').setExposure($exposure)"></div><div class="adj" data-class="{untouched: $gamma === 1}"><span class="adj__lbl">Gamma</span><span class="adj__val" data-text="$gamma.toFixed(2)">1.00</span><input class="adj__in" type="range" min="0.5" max="2" step="0.01" data-bind="gamma" aria-label="Gamma" data-on:input="document.getElementById('rv-I_056').setGamma($gamma)"></div><div class="adj" data-class="{untouched: $hue === 0}"><span class="adj__lbl">Hue</span><span class="adj__val" data-text="$hue + '°'">0°</span><input class="adj__in" type="range" min="-180" max="180" step="1" data-bind="hue" aria-label="Hue" data-on:input="document.getElementById('rv-I_056').setHue($hue)"></div><div class="adj adj--flag" data-class="{untouched: $invert === false}"><span class="adj__lbl">Invert</span><button type="button" class="vctl" data-attr="{'aria-pressed': $invert ? 'true' : 'false'}" data-on:click="$invert = !$invert; document.getElementById('rv-I_056').setInvert($invert)">Invert</button></div><div class="rv__rail-note">Adjustments are a way of looking, not a setting: they carry across plates and are forgotten when you leave.</div></div><div class="rv__rail-foot"><button type="button" class="vctl" data-on:click="$brightness = 1; $contrast = 1; $saturation = 1; $exposure = 0; $gamma = 1; $hue = 0; $invert = false; document.getElementById('rv-I_056').resetAdjust()">Reset all</button></div></div></div><div class="rv__bar"><span class="rv__err" aria-live="polite" aria-atomic="true" hidden data-attr="{'hidden': !$viewerError}">The zoomable image couldn't load.</span><div class="rv__ctrls"><span class="rv__scale" data-text="$scale">FIT</span><button type="button" class="vctl" id="rv-I_056-details-toggle" data-on:click="const open = $rail !== 'details'; $rail = open ? 'details' : 'closed'; if (open) setTimeout(() =&gt; document.getElementById('rv-I_056-details')?.querySelector('.rv__rail-head .vctl')?.focus({ preventScroll: true }), 0)" data-attr="{'aria-pressed': $rail === 'details' ? 'true' : 'false'}" title="Details" aria-label="Details"><span>Details</span></button><button type="button" class="vctl vctl--icon" id="rv-I_056-adjust-toggle" data-on:click="const open = $rail !== 'adjust'; $rail = open ? 'adjust' : 'closed'; if (open) setTimeout(() =&gt; document.getElementById('rv-I_056-adjust')?.querySelector('.rv__rail-head .vctl')?.focus({ preventScroll: true }), 0)" data-attr="{'aria-pressed': $rail === 'adjust' ? 'true' : 'false'}" title="Adjust" aria-label="Adjust"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4.3h11M2.5 8h11M2.5 11.7h11"></path><circle cx="10.4" cy="4.3" r="1.5"></circle><circle cx="5.6" cy="8" r="1.5"></circle><circle cx="11.4" cy="11.7" r="1.5"></circle></svg><span>Adjust</span></button><span class="vgroup"><button type="button" class="vctl vctl--icon" data-on:click="document.getElementById('rv-I_056').zoomOut()" data-attr="{'aria-disabled': $atMin ? 'true' : 'false'}" title="Zoom out" aria-label="Zoom out"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.4 8h9.2"></path></svg></button><button type="button" class="vctl vctl--icon" data-on:click="document.getElementById('rv-I_056').goHome()" data-attr="{'aria-disabled': $atHome ? 'true' : 'false'}" title="Fit to view" aria-label="Fit to view"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.6 7.3 8 2.9l5.4 4.4"></path><path d="M4.3 6.6V13h7.4V6.6"></path></svg></button><button type="button" class="vctl vctl--icon" data-on:click="document.getElementById('rv-I_056').zoomIn()" data-attr="{'aria-disabled': $atMax ? 'true' : 'false'}" title="Zoom in" aria-label="Zoom in"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3.4V12.6M3.4 8h9.2"></path></svg></button></span><button type="button" class="vctl vctl--icon vctl--wider" id="rv-I_056-wider-toggle" data-on:click="$expand = !$expand" data-attr="{'aria-pressed': $expand ? 'true' : 'false'}" title="Wider view" aria-label="Wider view"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2.6H2.6V6M10 2.6h3.4V6M13.4 10v3.4H10M6 13.4H2.6V10"></path></svg></button></div></div></div></div></div>
