<article class="record page record--viewer" data-class="{'is-wide': $expand}"><header class="record__head" data-attr="{'inert': $expand ? 'true' : false, 'aria-hidden': $expand ? 'true' : 'false'}"><div class="record__class"><p class="eyebrow">Character</p><span class="record__id">CH_001</span></div><h1 class="record__title">Alice</h1><blockquote class="record__quote">Curiouser and curiouser!<cite class="record__cite">Alice</cite></blockquote></header><div id="record-figure" tabindex="-1" class="rv-col page"><div class="em-head"><div class="em-head__group"><span class="em-head__title">Illustrations</span><span class="em-head__count">1</span></div></div><div class="rv-unit" data-restricted="false"><div class="rv" data-signals="{rail:'closed', expand:false, plate:0, stripOpen:true, brightness:1, contrast:1, saturation:1, exposure:0, gamma:1, hue:0, invert:false}" data-class="{'rail-adjust': $rail === 'adjust', 'rail-details': $rail === 'details'}"><div class="rv__banner"><span class="rv__legal"><span class="rv__legal-plate"></span></span></div><div class="rv__canvas"><div class="rv__stand"><img src="https://example.org/iiif/alice.jpg" alt="Alice" decoding="async" loading="eager" fetchpriority="high"></div><div class="rv__rail rv__rail--details" id="rv-I_001-details" role="region" aria-label="Details" data-attr="{'aria-hidden': $rail !== 'details' ? 'true' : 'false'}"><div class="rv__rail-head"><span>Details</span><button type="button" class="vctl" data-on:click="document.getElementById('rv-I_001-details-toggle')?.focus({ preventScroll: true }); $rail = 'closed'" title="Close" aria-label="Close"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.3 4.3 11.7 11.7M11.7 4.3 4.3 11.7"></path></svg></button></div><div class="rv__rail-body"><div class="rv-details"><dl class="rf"><div class="rf__row"><dt>Identifier</dt><dd class="rf__mono">I_001</dd></div><div class="rf__row"><dt>Dimensions</dt><dd class="rf__mono">800 × 600 px</dd></div><div class="rf__row"><dt>IIIF source</dt><dd class="rf__mono">https://example.org/iiif/alice.jpg</dd></div></dl></div></div></div></div><div class="rv__bar"><div class="rv__ctrls"><button type="button" class="vctl" id="rv-I_001-details-toggle" data-on:click="const open = $rail !== 'details'; $rail = open ? 'details' : 'closed'; if (open) setTimeout(() =&gt; document.getElementById('rv-I_001-details')?.querySelector('.rv__rail-head .vctl')?.focus({ preventScroll: true }), 0)" data-attr="{'aria-pressed': $rail === 'details' ? 'true' : 'false'}" title="Details" aria-label="Details"><span>Details</span></button><button type="button" class="vctl vctl--icon vctl--wider" id="rv-I_001-wider-toggle" data-on:click="$expand = !$expand" data-attr="{'aria-pressed': $expand ? 'true' : 'false'}" title="Wider view" aria-label="Wider view"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2.6H2.6V6M10 2.6h3.4V6M13.4 10v3.4H10M6 13.4H2.6V10"></path></svg></button></div></div></div></div></div><div class="record__body" data-attr="{'inert': $expand ? 'true' : false, 'aria-hidden': $expand ? 'true' : 'false'}"><div class="props"><div class="prop"><div class="prop__label">Description</div><div class="prop__value"><div class="v-richtext"><p>A <strong>curious</strong> girl who falls into Wonderland.</p>
</div></div></div><div class="prop"><div class="prop__label">Role</div><div class="prop__value"><span class="term">Protagonist</span></div></div><div class="prop"><div class="prop__label">Keyword</div><div class="prop__value"><ul class="keyword-set"><li class="keyword"><span class="path">Fiction</span><span class="leaf">Fantasy</span></li><li class="keyword"><span class="leaf">Adventure</span></li></ul></div></div><div class="prop"><div class="prop__label">Wikidata Link</div><div class="prop__value"><a class="ext-link" href="https://www.wikidata.org/wiki/Q179515" target="_blank" rel="noopener noreferrer">www.wikidata.org/wiki/Q179515</a></div></div><div class="prop"><div class="prop__label">Related</div><div class="prop__value"><span class="v-text">The White Rabbit</span></div></div></div></div></article>
