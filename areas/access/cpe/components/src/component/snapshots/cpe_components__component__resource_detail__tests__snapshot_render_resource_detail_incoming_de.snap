---
source: engine/src/component/resource_detail.rs
expression: "render_incoming(Some(&rows), &media, None, \"de\")"
---
<article class="record page record--viewer" data-class="{'is-wide': $expand}"><header class="record__head" data-attr="{'inert': $expand ? 'true' : false, 'aria-hidden': $expand ? 'true' : 'false'}"><div class="record__class"><p class="eyebrow">Band</p><span class="record__id">BAND_01</span></div><h1 class="record__title">Band one</h1></header><div id="record-figure" tabindex="-1" class="rv-col page"><div class="em-head"><div class="em-head__group"><span class="em-head__title">Illustrationen</span><span class="em-head__count">1</span></div></div><div class="rv-unit" data-restricted="false"><div class="rv" data-signals="{rail:'closed', expand:false, plate:0, stripOpen:true, brightness:1, contrast:1, saturation:1, exposure:0, gamma:1, hue:0, invert:false}" data-class="{'rail-adjust': $rail === 'adjust', 'rail-details': $rail === 'details'}"><div class="rv__banner"><span class="rv__legal"><span class="rv__legal-plate"></span></span></div><div class="rv__canvas"><div class="rv__stand"><img src="https://example.org/iiif/alice.jpg" alt="Band one" decoding="async" loading="eager" fetchpriority="high"></div><div class="rv__rail rv__rail--details" id="rv-I_001-details" role="region" aria-label="Details" data-attr="{'aria-hidden': $rail !== 'details' ? 'true' : 'false'}"><div class="rv__rail-head"><span>Details</span><button type="button" class="vctl" data-on:click="document.getElementById('rv-I_001-details-toggle')?.focus({ preventScroll: true }); $rail = 'closed'" title="Schliessen" aria-label="Schliessen"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.3 4.3 11.7 11.7M11.7 4.3 4.3 11.7"></path></svg></button></div><div class="rv__rail-body"><div class="rv-details"><dl class="rf"><div class="rf__row"><dt>Kennung</dt><dd class="rf__mono">I_001</dd></div><div class="rf__row"><dt>Abmessungen</dt><dd class="rf__mono">800 × 600 px</dd></div><div class="rf__row"><dt>IIIF-Quelle</dt><dd class="rf__mono">https://example.org/iiif/alice.jpg</dd></div></dl></div></div></div></div><div class="rv__bar"><div class="rv__ctrls"><button type="button" class="vctl" id="rv-I_001-details-toggle" data-on:click="const open = $rail !== 'details'; $rail = open ? 'details' : 'closed'; if (open) setTimeout(() =&gt; document.getElementById('rv-I_001-details')?.querySelector('.rv__rail-head .vctl')?.focus({ preventScroll: true }), 0)" data-attr="{'aria-pressed': $rail === 'details' ? 'true' : 'false'}" title="Details" aria-label="Details"><span>Details</span></button><button type="button" class="vctl vctl--icon vctl--wider" id="rv-I_001-wider-toggle" data-on:click="$expand = !$expand" data-attr="{'aria-pressed': $expand ? 'true' : 'false'}" title="Breitere Ansicht" aria-label="Breitere Ansicht"><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2.6H2.6V6M10 2.6h3.4V6M13.4 10v3.4H10M6 13.4H2.6V10"></path></svg></button></div></div></div></div></div><div class="record__body" data-attr="{'inert': $expand ? 'true' : false, 'aria-hidden': $expand ? 'true' : 'false'}"><div class="props"><div class="prop"><div class="prop__label">Width</div><div class="prop__value"><span class="v-number">42</span></div></div></div><section class="pgroup incoming"><header class="pgroup__head"><span class="pgroup__title">Folios</span></header><ul class="incoming__list"><li class="incoming__item"><a class="int-link incoming__name" href="/demo/folios/F_1"><span class="ref">Name F_1</span></a> <span class="incoming__via">Band links</span></li><li class="incoming__item"><a class="int-link incoming__name" href="/demo/volumes/VOL_1?page=L_2"><span class="ref">Name L_2</span></a> <span class="incoming__via">Band Right</span></li><li class="incoming__item"><span class="incoming__name">Name L_3</span> <span class="incoming__via">Band links</span></li></ul></section></div></article>
