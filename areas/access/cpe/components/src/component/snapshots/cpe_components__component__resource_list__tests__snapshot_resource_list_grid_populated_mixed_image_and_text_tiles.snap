<section class="resource-list-section page"><div class="surf-head"><div class="surf-head__group"><span class="surf-head__title">Character</span><span class="surf-head__count" id="browse-count" aria-live="polite" aria-atomic="true">2 Character</span></div><div class="surf-head__ctl"><div class="viewtoggle"><span class="viewtoggle__lbl" id="viewtoggle-lbl">View</span><div class="viewtoggle__opts" role="group" aria-labelledby="viewtoggle-lbl"><a class="viewtoggle__opt" href="/alice-in-daschland/characters">List</a><a class="viewtoggle__opt" href="/alice-in-daschland/characters?view=grid" aria-current="true">Grid</a></div></div><form class="orderctl" method="get" action="/alice-in-daschland/characters"><input type="hidden" name="view" value="grid"><span class="viewtoggle__lbl">Order</span><details class="orderctl__disc" id="orderctl" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; el.open &amp;&amp; (evt.preventDefault(), el.open = false, el.querySelector('summary').focus({preventScroll: true}))" data-on:click__outside="el.open = false" data-on:focusout="evt.relatedTarget &amp;&amp; evt.relatedTarget.tabIndex &gt;= 0 &amp;&amp; !el.contains(evt.relatedTarget) &amp;&amp; (el.open = false)"><summary class="orderctl__current" aria-label="Order: As curated">As curated<span class="orderctl__caret" aria-hidden="true">▾</span></summary><div class="orderctl__panel"><button class="orderctl__opt" type="submit" name="sort" value="default" aria-current="true">As curated</button><button class="orderctl__opt" type="submit" name="sort" value="name">Name A–Z</button><button class="orderctl__opt" type="submit" name="sort" value="name-desc">Name Z–A</button><button class="orderctl__opt" type="submit" name="sort" value="id">Identifier</button></div></details><span class="visually-hidden orderctl__status" id="orderctl-status" aria-live="polite" aria-atomic="true">Order: As curated</span></form></div></div><ul class="gm"><li><div class="gm__tile"><div class="gm__box"><img src="https://iiif.demo.dasch.swiss:443/0854/abc.jpx/full/512,/0/default.jpg" alt="" loading="lazy"></div><div class="gm__name">Alice</div></div></li><li><div class="gm__tile"><div class="gm__box gm__box--text"><div class="gm__text"><span class="k" aria-hidden="true">No illustration</span><span class="g">A curious girl in a world of nonsense.</span></div></div><div class="gm__name">The White Rabbit</div></div></li></ul></section>
