<section class="resource-list-section page" id="character-list"><div class="surf-head"><div class="surf-head__group"><span class="surf-head__title">Character</span><span class="surf-head__count" id="browse-count" aria-live="polite" aria-atomic="true">8 of 54 Character</span></div><div class="surf-head__ctl"><form class="orderctl" method="get" action="/alice-in-daschland/characters" data-active="true" data-on:submit__prevent="evt.submitter ? (document.getElementById('orderctl').open = false, document.getElementById('orderctl').querySelector('summary').focus({preventScroll: true}), @get('/alice-in-daschland/characters/_sort?role=n1&amp;sort=' + evt.submitter.value)) : el.submit()"><input type="hidden" name="role" value="n1"><span class="viewtoggle__lbl">Order</span><details class="orderctl__disc" id="orderctl" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; el.open &amp;&amp; (evt.preventDefault(), el.open = false, el.querySelector('summary').focus({preventScroll: true}))" data-on:click__outside="el.open = false" data-on:focusout="evt.relatedTarget &amp;&amp; evt.relatedTarget.tabIndex &gt;= 0 &amp;&amp; !el.contains(evt.relatedTarget) &amp;&amp; (el.open = false)"><summary class="orderctl__current" aria-label="Order: Name A–Z">Name A–Z<span class="orderctl__caret" aria-hidden="true">▾</span></summary><div class="orderctl__panel"><button class="orderctl__opt" type="submit" name="sort" value="default">As curated</button><button class="orderctl__opt" type="submit" name="sort" value="name" aria-current="true">Name A–Z</button><button class="orderctl__opt" type="submit" name="sort" value="name-desc">Name Z–A</button><button class="orderctl__opt" type="submit" name="sort" value="id">Identifier</button></div></details><span class="visually-hidden orderctl__status" id="orderctl-status" aria-live="polite" aria-atomic="true">Order: Name A–Z</span></form></div></div><ul class="rl-annot"><li class="rl-annot__item"><a class="rl-annot__row" href="/alice-in-daschland/characters/CH_010"><div class="rl-annot__main"><div class="rl-annot__name">The Mock Turtle</div></div></a></li><li class="rl-annot__item"><a class="rl-annot__row" href="/alice-in-daschland/characters/CH_011"><div class="rl-annot__main"><div class="rl-annot__name">The Gryphon</div></div></a></li></ul></section>
