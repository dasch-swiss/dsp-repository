<section class="resource-list-section page"><div class="surf-head"><div class="surf-head__group"><span class="surf-head__title">Character</span><span class="surf-head__count" id="browse-count" aria-live="polite" aria-atomic="true">0 of 20 Character</span></div><div class="surf-head__ctl"><form class="orderctl" method="get" action="/alice-in-daschland/characters"><input type="hidden" name="q" value="xyzzy"><input type="hidden" name="role" value="R_01"><span class="viewtoggle__lbl">Order</span><details class="orderctl__disc" id="orderctl" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; el.open &amp;&amp; (evt.preventDefault(), el.open = false, el.querySelector('summary').focus({preventScroll: true}))" data-on:click__outside="el.open = false" data-on:focusout="evt.relatedTarget &amp;&amp; evt.relatedTarget.tabIndex &gt;= 0 &amp;&amp; !el.contains(evt.relatedTarget) &amp;&amp; (el.open = false)"><summary class="orderctl__current" aria-label="Order: As curated">As curated<span class="orderctl__caret" aria-hidden="true">▾</span></summary><div class="orderctl__panel"><button class="orderctl__opt" type="submit" name="sort" value="default" aria-current="true">As curated</button><button class="orderctl__opt" type="submit" name="sort" value="name">Name A–Z</button><button class="orderctl__opt" type="submit" name="sort" value="name-desc">Name Z–A</button><button class="orderctl__opt" type="submit" name="sort" value="id">Identifier</button></div></details><span class="visually-hidden orderctl__status" id="orderctl-status" aria-live="polite" aria-atomic="true">Order: As curated</span></form></div></div><div class="search-empty"><p class="search-empty__msg">No characters match <em>&quot;xyzzy&quot;</em>.</p><div class="search-empty__acts"><a class="search-empty__act" href="/alice-in-daschland/characters">Clear search</a><a class="search-empty__act" href="/alice-in-daschland/characters?role=R_01">Clear all filters</a></div><p class="search-empty__hint">Matching is on the beginning of words — try a shorter term.</p></div></section>
