<section class="resource-list-section page"><div class="surf-head"><div class="surf-head__group"><span class="surf-head__title">Character</span><span class="surf-head__count" id="browse-count" aria-live="polite" aria-atomic="true">2 Character</span></div><div class="surf-head__ctl"><form class="orderctl" method="get" action="/alice-in-daschland/characters"><span class="viewtoggle__lbl">Order</span><details class="orderctl__disc" id="orderctl" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; el.open &amp;&amp; (evt.preventDefault(), el.open = false, el.querySelector('summary').focus({preventScroll: true}))" data-on:click__outside="el.open = false" data-on:focusout="evt.relatedTarget &amp;&amp; evt.relatedTarget.tabIndex &gt;= 0 &amp;&amp; !el.contains(evt.relatedTarget) &amp;&amp; (el.open = false)"><summary class="orderctl__current" aria-label="Order: As curated">As curated<span class="orderctl__caret" aria-hidden="true">▾</span></summary><div class="orderctl__panel"><button class="orderctl__opt" type="submit" name="sort" value="default" aria-current="true">As curated</button><button class="orderctl__opt" type="submit" name="sort" value="name">Name A–Z</button><button class="orderctl__opt" type="submit" name="sort" value="name-desc">Name Z–A</button><button class="orderctl__opt" type="submit" name="sort" value="id">Identifier</button></div></details><span class="visually-hidden orderctl__status" id="orderctl-status" aria-live="polite" aria-atomic="true">Order: As curated</span></form></div></div><ul class="rl-annot"><li class="rl-annot__item"><a class="rl-annot__row" href="/alice-in-daschland/characters/CH_001"><div class="rl-annot__main"><div class="rl-annot__name">Alice</div></div></a></li><li class="rl-annot__item"><a class="rl-annot__row" href="/alice-in-daschland/characters/CH_002"><div class="rl-annot__main"><div class="rl-annot__name">The White Rabbit</div></div></a></li></ul></section>
