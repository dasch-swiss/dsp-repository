---
source: engine/src/component/resource_list.rs
expression: out
---
<section class="resource-list-section page" id="book-list"><div class="surf-head"><div class="surf-head__group"><span class="surf-head__title">Book</span><span class="surf-head__count" id="browse-count" aria-live="polite" aria-atomic="true">2 Book</span></div><div class="surf-head__ctl"><form class="orderctl" method="get" action="/incunabula/books" data-active="true" data-on:submit__prevent="evt.submitter ? (document.getElementById('orderctl').open = false, document.getElementById('orderctl').querySelector('summary').focus({preventScroll: true}), @get('/incunabula/books/_sort?role=n1&amp;sort=' + evt.submitter.value)) : el.submit()"><input type="hidden" name="role" value="n1"><span class="viewtoggle__lbl">Order</span><details class="orderctl__disc" id="orderctl" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; el.open &amp;&amp; (evt.preventDefault(), el.open = false, el.querySelector('summary').focus({preventScroll: true}))" data-on:click__outside="el.open = false" data-on:focusout="evt.relatedTarget &amp;&amp; evt.relatedTarget.tabIndex &gt;= 0 &amp;&amp; !el.contains(evt.relatedTarget) &amp;&amp; (el.open = false)"><summary class="orderctl__current" aria-label="Order: Date">Date<span class="orderctl__caret" aria-hidden="true">▾</span></summary><div class="orderctl__panel"><button class="orderctl__opt" type="submit" name="sort" value="default">As curated</button><button class="orderctl__opt" type="submit" name="sort" value="name">Name A–Z</button><button class="orderctl__opt" type="submit" name="sort" value="name-desc">Name Z–A</button><button class="orderctl__opt" type="submit" name="sort" value="id">Identifier</button><button class="orderctl__opt" type="submit" name="sort" value="date" aria-current="true">Date</button><button class="orderctl__opt" type="submit" name="sort" value="extent">Extent</button></div></details><span class="visually-hidden orderctl__status" id="orderctl-status" aria-live="polite" aria-atomic="true">Order: Date</span></form></div></div><ul class="rl-annot"><li class="rl-annot__item"><div class="rl-annot__row"><div class="rl-annot__main"><div class="rl-annot__name">Zeitglöcklein</div></div></div></li><li class="rl-annot__item"><div class="rl-annot__row"><div class="rl-annot__main"><div class="rl-annot__name">Narrenschiff</div></div></div></li></ul></section>
