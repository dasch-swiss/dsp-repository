<form class="search-row" role="search" method="get" action="/alice-in-daschland/characters"><input type="hidden" name="role" value="R_01"><input type="hidden" name="role" value="R_02"><label class="search-row__lbl" for="q">Search</label><div class="search-bar"><input class="search-bar__input" id="q" type="search" name="q" value="" autocomplete="off" data-on:input__debounce.250ms="@get('/alice-in-daschland/characters/_search?role=R_01&amp;role=R_02&amp;q=' + encodeURIComponent(evt.target.value))"><button class="search-bar__clear" type="submit" name="q" value="" title="Clear search" aria-label="Clear search" data-on:click__prevent="el.form.querySelector('#q').value = ''; @get('/alice-in-daschland/characters/_search?role=R_01&amp;role=R_02&amp;q=')">×</button><button class="search-bar__go" type="submit" title="Search" aria-label="Search">→</button></div></form>
