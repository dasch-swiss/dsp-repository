load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# CPE's two ports. The one CPE crate other capabilities see: sync-store and media-store answer
# them, and the composition root hands their adapters over (ADR-0007). A store that comes to answer
# a port adds its package here; no other crate of another capability does.
rust_library(
    name = "cpe_ports",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "cpe_ports",
    visibility = [
        "//areas/access/cpe/server:__pkg__",
        "//areas/access/cpe/store-build:__pkg__",
        "//areas/access/media/store:__pkg__",
        "//areas/access/server:__pkg__",
        "//areas/access/sync/store:__pkg__",
    ],
    deps = ["//shared/names:shared_names"],
)

rust_test(
    name = "cpe_ports_test",
    crate = ":cpe_ports",
)
