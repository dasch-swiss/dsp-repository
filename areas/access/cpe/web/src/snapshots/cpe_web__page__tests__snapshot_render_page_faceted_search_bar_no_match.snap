<!DOCTYPE html><html lang="en" data-direction="edition" data-accent="ochre" data-bg="tint" data-pick="newsreader"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Alice in DaSCHland</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&amp;family=Lora:ital,wght@0,400;0,500;0,600;1,400&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;display=swap"><link rel="stylesheet" href="/_static/cpe/tokens.css"><link rel="stylesheet" href="/_static/cpe/shell.css"><link rel="stylesheet" href="/_static/cpe/editorial.css"><link rel="stylesheet" href="/_static/cpe/record.css"><link rel="stylesheet" href="/_static/cpe/grid.css"><link rel="stylesheet" href="/_static/cpe/media.css"><link rel="stylesheet" href="/_static/cpe/incunabula.css"><script type="module" src="/_static/datastar.js"></script><script type="module" src="/_static/image-viewer/image-viewer.js"></script></head><body><a class="skip-link" href="#main">Skip to content</a><div class="shell"><header class="shell__header"><div class="header__inner"><div class="brand"><a class="brand__mark" href="/">CPE</a><span class="brand__sep">/</span><a class="brand__project" href="/alice-in-daschland/" title="Alice in DaSCHland">Alice in DaSCHland</a></div><button class="header__menu-btn" type="button" popovertarget="header-menu"><span class="header__menu-bars" aria-hidden="true"><span></span><span></span><span></span></span><span class="header__menu-label">Menu</span></button><div id="header-menu" popover="auto" data-on:resize__window__throttle.200ms.trailing="el.hidePopover &amp;&amp; window.matchMedia('(min-width: 79rem)').matches &amp;&amp; el.matches(':popover-open') &amp;&amp; el.hidePopover()"><nav class="header__nav" aria-label="Primar