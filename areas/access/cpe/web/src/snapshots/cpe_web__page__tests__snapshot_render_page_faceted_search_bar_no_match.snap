ntains(evt.relatedTarget) &amp;&amp; (el.open = false)"><summary class="orderctl__current" aria-label="Order: As curated">As curated<span class="orderctl__caret" aria-hidden="true">▾</span></summary><div class="orderctl__panel"><button class="orderctl__opt" type="submit" name="sort" value="default" aria-current="true">As curated</button><button class="orderctl__opt" type="submit" name="sort" value="name">Name A–Z</button><button class="orderctl__opt" type="submit" name="sort" value="name-desc">Name Z–A</button><button class="orderctl__opt" type="submit" name="sort" value="id">Identifier</button></div></details><span class="visually-hidden orderctl__status" id="orderctl-status" aria-live="polite" aria-atomic="true">Order: As curated</span></form></div></div><div class="search-empty"><p class="search-empty__msg">No Character match <em>&quot;xyzzy&quot;</em> with these filters.</p><div class="search-empty__acts"><a class="search-empty__act" href="/alice-in-daschland/characters?role=R_01">Clear search</a><a class="search-empty__act" href="/alice-in-daschland/characters">Clear all filters</a></div><p class="search-empty__hint">Matching is on the beginning of words — try a shorter term.</p></div></section></section></main><footer class="shell__footer"><div class="footer__inner"><span class="brand__mark footer__mark">CPE</span><p class="footer__desc">A DaSCH showcase project.</p><a class="dasch-logo footer__lockup" href="https://www.dasch.swiss" aria-label="DaSCH — Swiss National Data and Service Center for the Humanities (dasch.swiss)"><img class="dasch-logo__img dasch-logo__img--light" src="/_static/cpe/dasch-logo-colour.svg" alt="" width="2147" height="621"><img class="dasch-logo__img dasch-logo__img--dark" src="/_static/cpe/dasch-logo-white.svg" alt="" width="2148" height="622"></a><p class="footer__attr">Part of the DaSCH Configurable Presentation Environment — a <strong>DaSCH</strong> research infrastructure service.</p></div></footer></div></body></html>
