// broken-annotation-color-raw — broken-annotation-color's data with the site
// title omitted, so lowering fails (MissingSiteTitle) and validate_with_data
// takes its raw arm, which must still report MalformedAnnotation.
site {
    // title intentionally omitted → MissingSiteTitle (config-internal, hard-fail)
    languages "de" "en"
}

page id="home" route="/"
