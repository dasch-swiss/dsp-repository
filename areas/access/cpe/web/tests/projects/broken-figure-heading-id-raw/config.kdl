// broken-figure-heading-id-raw — a heading id outside [a-z0-9-] and one used twice.
// The site block is deliberately broken (missing 'title') so validate_with_data
// takes the raw arm; the raw narrative check must still report.
// Expected: InvalidHeadingId x2, both in woodcuts.de.md (the EN variant is clean) + MissingSiteTitle. Loaded as "incunabula".
site {
    // title intentionally omitted → MissingSiteTitle (config-internal, hard-fail)
    languages "de" "en"
    chrome {
        string "four-count" {
            de "4 Fälle"
            en "4 cases"
        }
        string "strips-all" {
            de "Alle Randleisten"
            en "All border strips"
        }
    }
}

page id="home" route="/" {
    narrative file="woodcuts.md"
    timeline class="Book" date-property="pub-date" lane-property="office" axis-start=1470 axis-end=1506 section="four"
}

page id="strips" route="/strips" {
    narrative file="strips.md"
}
