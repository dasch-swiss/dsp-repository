// broken-figure-invite-list — the slot names a ## heading followed by an invite list.
// Expected: FigureSectionHoldsInviteList. Loaded as "incunabula".
site {
    title "Figure Fixture"
    languages "de" "en"
    chrome {
        string "four-count" {
            de "4 Fälle"
            en "4 cases"
        }
        string "strips-all" {
            de "Alle Randleisten"
            en "All border strips"
        }
    }
}

page id="home" route="/" {
    narrative file="woodcuts.md"
    timeline class="Book" date-property="pub-date" lane-property="office" axis-start=1470 axis-end=1506 section="explore"
}

page id="strips" route="/strips" {
    narrative file="strips.md"
}
