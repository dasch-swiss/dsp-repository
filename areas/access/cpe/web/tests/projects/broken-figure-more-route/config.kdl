// broken-figure-more-route — the slot's more-route names no declared page.
// Expected: UnresolvedFigureMoreRoute (Error). Loaded as "incunabula".
site {
    title "Figure Fixture"
    languages "de" "en"
    chrome {
        string "four-count" {
            de "4 Fälle"
            en "4 cases"
        }
        string "strips-all" {
            de "Alle Randleisten"
            en "All border strips"
        }
    }
}

page id="home" route="/" {
    narrative file="woodcuts.md"
    timeline class="Book" date-property="pub-date" lane-property="office" axis-start=1470 axis-end=1506 section="four" more-label="strips-all" more-route="/nowhere"
}

page id="strips" route="/strips" {
    narrative file="strips.md"
}
