// broken-gloss-incompatible-part-raw — exercises check_resource_list_data_into_raw.
// A port of broken-gloss-incompatible-part/ with the site title deliberately
// omitted so validate_with_data takes the Err/raw branch; the raw pass must
// still walk the gloss block's own children.
//
// Expected diagnostics: MissingSiteTitle (Error) + IncompatibleGlossPart (Error) ×2.
site {
    // title intentionally omitted -> MissingSiteTitle (config-internal, hard-fail)
    languages "de" "en"
    chrome {
        string "gloss-extent" {
            de "{n} Seiten"
            en "{n} pages"
        }
    }
}

page id="books" route="/books" {
    resource-list class="Book" {
        gloss {
            part property="office"
            part property="pub-place" unit="gloss-extent"
            part property="extent" unit="gloss-extent"
        }
    }
}
