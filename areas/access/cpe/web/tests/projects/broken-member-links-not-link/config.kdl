// broken-member-links-not-link — a `compound-viewer member-links` row
// listing a member property that is not `link`-typed (`caption`, text on
// Page). The row renders only link values, so it is IncompatibleGlossPart
// with the role "member link". `strip-left` is a real link and is fine.
//
// Expected diagnostics: IncompatibleGlossPart (Error) ×1.
site {
    title "Broken Member Links"
    languages "de" "en"
    chrome {
        string "strips" {
            de "Randleisten"
            en "Border strips"
        }
    }
}

page id="book" route="/books/:id" {
    resource-detail id="$id" class="Book"
    compound-viewer source="$id" layout="pages" index="none" media="image" {
        member-links label="strips" "strip-left" "caption"
    }
}
