// broken-order-by-duplicate-key — fires DuplicateOrderKey (Error): two `order-by` options on one
// list share `key="date"`. A lowering error (config-internal), no -raw sibling.
site {
    title "Broken Order By Duplicate Key"
    languages "de" "en"
    chrome {
        string "order-book-date" {
            de "Datum"
            en "Date"
        }
    }
}

page id="books" route="/books" {
    resource-list class="Book" {
        sort property="pub-date"
        order-by key="date" property="pub-date" label="order-book-date"
        order-by key="date" property="name" direction="desc" label="order-book-date"
    }
}
