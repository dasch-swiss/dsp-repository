// broken-showcase-crop-uri-raw — sized crop images whose URI the renderer
// cannot crop: c1v's has no /full/max/ segment, c8r's is ftp:. Expected:
// CropImageNotIiif for an-c1v x2, an-c8r x2 and the an-note detail (on c1v),
// with the site title deliberately missing
// (MissingSiteTitle), so validate_with_data takes the raw arm, which must
// still run the woodcut-cases data checks.
// Loaded as "incunabula" (woodcut-cases is registered for it).
site {
    languages "de" "en"
    chrome {
        string "remark-e2" {
            de "Ein Stock in zwei Ausgaben."
            en "One block in two editions."
        }
    }
}

page id="home" route="/" {
    narrative file="woodcuts.md"
    woodcut-cases section="editions" layout="edition" media="image" {
        case schramm=1124 title="Kap. 13 · Von der Buhlerei" remark-link="L-e1" {
            crop "an-c1v" alt="Holzschnitt zu Kap. 13: Von der Buhlerei."
            crop "an-c8r" alt="Holzschnitt zu Kap. 13: Von der Buhlerei."
            detail "an-note" alt="Handschriftliche Bemerkung in der Zeichnung"
        }
        case remark="remark-e2" {
            crop "an-c8r"
            crop "an-c1v"
        }
        page-case link="L-page" remark-excerpt="Anbetung des Kindes." {
            page "pg-h8r"
            page "pg-c6v"
        }
    }
}
