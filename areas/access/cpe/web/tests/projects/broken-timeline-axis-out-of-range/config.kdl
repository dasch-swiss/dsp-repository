// broken-timeline-axis-out-of-range — fires TimelineAxisOutOfRange (Error): axis-end=3000000000 does not fit
// in an i32.
// Loaded as project "incunabula" (Slice 4 step 8 keys the component on it).
site {
    title "Timeline Fixture"
    languages "de" "en"
}

page id="home" route="/" {
    timeline class="Book" date-property="pub-date" lane-property="office" extent-property="extent" axis-start=1470 axis-end=3000000000
}
