// broken-timeline-extent-sparse — loads with SparseTimelineProperty (Warning): extent-property
// "page-count" exists in the data (on Page) but on no Book. The extent
// segment is optional, so this tier stays advisory.
// Loaded as project "incunabula" (Slice 4 step 8 keys the component on it).
site {
    title "Timeline Fixture"
    languages "de" "en"
}

page id="home" route="/" {
    timeline class="Book" date-property="pub-date" lane-property="office" extent-property="page-count" axis-start=1470 axis-end=1506
}
