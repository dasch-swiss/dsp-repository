// broken-timeline-extent-wrong-type — fires IncompatibleTimelineProperty (Error): extent-property "name" is
// stored as 'text' on Book, but the extent role requires 'integer'.
// Loaded as project "incunabula" (Slice 4 step 8 keys the component on it).
site {
    title "Timeline Fixture"
    languages "de" "en"
}

page id="home" route="/" {
    timeline class="Book" date-property="pub-date" lane-property="office" extent-property="name" axis-start=1470 axis-end=1506
}
