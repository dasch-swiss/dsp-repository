// broken-timeline-lane-wrong-type — fires IncompatibleTimelineProperty (Error): lane-property "extent" is
// stored as 'integer' on Book, but the lane role requires 'list_value'.
// Loaded as project "incunabula" (Slice 4 step 8 keys the component on it).
site {
    title "Timeline Fixture"
    languages "de" "en"
}

page id="home" route="/" {
    timeline class="Book" date-property="pub-date" lane-property="extent" extent-property="extent" axis-start=1470 axis-end=1506
}
