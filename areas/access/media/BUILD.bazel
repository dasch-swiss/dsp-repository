# The committed deposited files of project 0803, in the stand-in layout: a fixture for the tests
# that build CPE over them. Keep it `testonly`, or access-server's image, which reads the VRE
# bridge's location instead, could carry it.
filegroup(
    name = "data",
    testonly = True,
    srcs = glob(["data/**"]),
    visibility = [
        "//areas/access/cpe/server:__pkg__",
        "//areas/access/cpe/store-build:__pkg__",
        "//areas/access/server:__pkg__",
        "//areas/access/sync/store:__pkg__",
    ],
)
