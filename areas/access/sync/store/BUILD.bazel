load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_test_suite")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")

_SRCS = glob(["src/**/*.rs"])

_DEPS = [
    "//areas/access/cpe/ports:cpe_ports",
    "//shared/names:shared_names",
    "//shared/stand-in:shared_stand_in",
    "@crates//:oxrdf",
    "@crates//:oxttl",
    "@crates//:thiserror",
    "@crates//:tracing",
]

# sync's adapter of CPE's archive-projection port. Only the composition root links it
# (ADR-0003, ADR-0008).
rust_library(
    name = "sync_store",
    srcs = _SRCS,
    crate_name = "sync_store",
    visibility = ["//areas/access/server:__pkg__"],
    deps = _DEPS,
)

# The only target another capability sees: CPE's tests build their store over the committed data
# through it (ADR-0012). A library of its own, not an `alias`: Bazel checks `testonly` on an
# alias's actual target, so only a `testonly` library keeps it out of every production target.
rust_library(
    name = "sync_store_for_tests",
    testonly = True,
    srcs = _SRCS,
    crate_name = "sync_store",
    visibility = [
        "//areas/access/cpe/server:__pkg__",
        "//areas/access/cpe/store-build:__pkg__",
    ],
    deps = _DEPS,
)

rust_test(
    name = "sync_store_test",
    crate = ":sync_store",
    deps = ["@crates//:tempfile"],
)

# The adapter refuses a symlinked token or snapshot, and runfiles are symbolic links, so the
# committed data is read from a copy at its repository paths, below `test_files/`, and the test runs
# outside the local sandbox, which would link each copied file again.
copy_to_directory(
    name = "test_files",
    testonly = True,
    srcs = [
        "//areas/access/media:data",
        "//areas/access/sync:data",
    ],
    root_paths = [],
)

rust_test_suite(
    name = "sync_store_integration",
    srcs = glob(["tests/*.rs"]),
    data = [":test_files"],
    rustc_env = {"CARGO_MANIFEST_DIR": "areas/access/sync/store"},
    tags = ["no-sandbox"],
    deps = [
        ":sync_store",
        "//areas/access/cpe/ports:cpe_ports",
        "//shared/stand-in:shared_stand_in",
    ],
)
