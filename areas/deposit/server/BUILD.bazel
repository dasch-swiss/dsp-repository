load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//tools/image:defs.bzl", "MUSL", "app_image", "binary_layer", "files_layer")

# The Deposit Area's composition root (ADR-0003, `areas/deposit/ADR-0004`): the binary links the two
# web crates, the two store crates and the shell, and no `core` or `ports` crate. Its tests also
# take `editor-ports`' fakes, through its `testonly` variant.
_DEPS = [
    "//areas/deposit/shell:deposit_shell",
    "//shared/rate-limit:shared_rate_limit",
    "//shared/telemetry:shared_telemetry",
    "@crates//:axum",
    "@crates//:axum-tracing-opentelemetry",
    "@crates//:clap",
    "@crates//:figment",
    "@crates//:init-tracing-opentelemetry",
    "@crates//:matchit",
    "@crates//:opentelemetry",
    "@crates//:opentelemetry-appender-tracing",
    "@crates//:opentelemetry-otlp",
    "@crates//:opentelemetry_sdk",
    "@crates//:pyroscope",
    "@crates//:rustls",
    "@crates//:serde",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tower-http",
    "@crates//:tower_governor",
    "@crates//:tracing",
    "@crates//:tracing-opentelemetry",
    "@crates//:tracing-subscriber",
    "@crates//:ureq",
]

_SRCS = glob(["src/**/*.rs"])

# The tests read the editor's public directory through `CARGO_MANIFEST_DIR`, and the corpus through
# `editor-web`'s test support.
_RUSTC_ENV = {"CARGO_MANIFEST_DIR": "areas/deposit/server"}

rust_binary(
    name = "deposit_server",
    srcs = _SRCS,
    crate_name = "deposit_server",
    rustc_env = _RUSTC_ENV,
    deps = _DEPS + [
        "//areas/deposit/editor/store:editor_store",
        "//areas/deposit/editor/web:editor_web",
        "//areas/deposit/identity/store:identity_store",
        "//areas/deposit/identity/web:identity_web",
    ],
)

# Not `crate = ":deposit_server"`: the tests take every capability crate's `test-support` variant,
# and a test inherits its crate's dependencies, so the production builds of the same crates would
# meet the variants in one compile.
rust_test(
    name = "deposit_server_test",
    srcs = _SRCS,
    crate_name = "deposit_server",
    crate_root = "src/main.rs",
    data = [
        "//areas/access/dpe/server:corpus",
        "//areas/deposit/editor:public",
    ],
    # One test thread: the configuration tests' `figment::Jail` moves the process into a temporary
    # directory while it runs, and other tests read files through the relative `CARGO_MANIFEST_DIR`.
    env = {"RUST_TEST_THREADS": "1"},
    rustc_env = _RUSTC_ENV,
    deps = _DEPS + [
        "//areas/deposit/editor/ports:editor_ports_test_support",
        "//areas/deposit/editor/store:editor_store_test_support",
        "//areas/deposit/editor/web:editor_web_test_support",
        "//areas/deposit/identity/store:identity_store_test_support",
        "//areas/deposit/identity/web:identity_web_test_support",
        "@crates//:chrono",
        "@crates//:tower",
    ],
)

# ── The editor image, `daschswiss/metadata-editor` ─────────────────────────
#
# A static musl binary on distroless `static` (`//tools/image:defs.bzl`), built with
# `--config=release --stamp` (the version in the footer) by `just build-docker-editor`, which
# loads it, and pushed by the `docker-publish` action. An OCI image has no `HEALTHCHECK`, and
# `healthcheck` remains a subcommand. The base runs as uid 65532 (distroless `nonroot`), so the
# directory `EDITOR_DB_DIR` points at must be writable by 65532: chowned to 65534 it fails with
# `unable to open database file`, which reads like a wrong mount path.
binary_layer(
    name = "image_binary",
    binary = ":deposit_server",
    path = "/app/deposit-server",
    target_compatible_with = MUSL,
)

files_layer(
    name = "image_public",
    srcs = [
        "//areas/deposit/editor:css",
        "//areas/deposit/editor:public",
    ],
    prefixes = {
        "areas/deposit/editor/css": "app/public/assets",
        "areas/deposit/editor/public": "app/public",
    },
    target_compatible_with = MUSL,
)

# DPE's published set as the editor's data directory: a data change reaches the editor when the
# image is rebuilt, not at run time.
files_layer(
    name = "image_data",
    srcs = ["//areas/access/dpe/server:corpus"],
    prefixes = {"areas/access/dpe/server/data": "app/server/data"},
    target_compatible_with = MUSL,
)

app_image(
    name = "image",
    repository = "index.docker.io/daschswiss/metadata-editor",
    scan_tag = "local-scan/editor:latest",
    cmd = ["serve"],
    entrypoint = ["./deposit-server"],
    # `EDITOR_DB_DIR` stays unset: an in-memory database. The Cloud Run previews run this image with
    # no volume and publicly reachable, so a default path would let a preview accumulate login codes,
    # sessions and drafts; production sets it through the deployment
    # (docs/src/editor/operations.md#database).
    env = {
        "RUST_LOG": "info",
        # The panic hook's backtrace, with the line tables `--config=release` keeps.
        "RUST_BACKTRACE": "1",
        "EDITOR_SITE_ADDR": "0.0.0.0:8080",
        "EDITOR_ENV": "PROD",
        "EDITOR_PUBLIC_DIR": "/app/public",
        "EDITOR_DATA_DIR": "/app/server/data",
    },
    exposed_ports = ["8080/tcp"],
    tars = [
        ":image_binary",
        ":image_public",
        ":image_data",
    ],
    workdir = "/app",
)
