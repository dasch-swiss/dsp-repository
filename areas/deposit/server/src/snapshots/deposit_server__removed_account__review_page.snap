"temporalCoverage.row" value=""><button class="btn btn-secondary repeatable-add" type="submit" formaction="/temporalCoverage/add" formmethod="post">Add</button><p class="field-hint" id="temporalCoverage-hint">The time period the data covers. Search for a recognised period, for example Bronze Age or Siècle des Lumières, and we'll record the authority link — or add your own term per language.</p><p class="field-error" id="temporalCoverage-error" aria-live="polite"></p></fieldset></div></div><div class="border-t border-neutral-200 px-4 py-3"><fieldset class="field field-group" id="decision.temporalCoverage"><legend class="field-label">Temporal coverage — decision</legend><div class="field-choices field-choices-inline"><label class="field-choice" for="decision.temporalCoverage-0"><input class="field-choice-input" type="radio" id="decision.temporalCoverage-0" name="decision.temporalCoverage" value="accept"><span class="field-choice-label">Accept</span></label><label class="field-choice" for="decision.temporalCoverage-1"><input class="field-choice-input" type="radio" id="decision.temporalCoverage-1" name="decision.temporalCoverage" value="revert"><span class="field-choice-label">Revert</span></label><label class="field-choice" for="decision.temporalCoverage-2"><input class="field-choice-input" type="radio" id="decision.temporalCoverage-2" name="decision.temporalCoverage" value="" checked><span class="field-choice-label">Not reviewed yet</span></label></div><p class="field-error" id="decision.temporalCoverage-error" aria-live="polite"></p></fieldset></div></div><div class="rounded border border-neutral-300 bg-white"><div class="flex flex-wrap items-center gap-3 border-b border-neutral-200 px-4 py-2"><strong>Spatial coverage</strong><span class="badge badge-warning badge-md">Needs review</span></div><div class="grid gap-4 border-t border-neutral-200 p-4 md:grid-cols-2"><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Published</p><p class="text-neutral-900">1 entry</p></div><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Submitted</p><fieldset class="field field-group" id="spatialCoverage" aria-describedby="spatialCoverage-hint"><legend class="field-label">Spatial coverage <span class="w-fit rounded bg-warning-50 px-2 py-0.5 text-xs font-bold text-warning-800">Required</span></legend><input type="hidden" name="spatialCoverage.row" value=""><button class="btn btn-secondary repeatable-add" type="submit" formaction="/spatialCoverage/add" formmethod="post">Add</button><p class="field-hint" id="spatialCoverage-hint">Search for a place; we'll record the standard reference link for you.</p><p class="field-error" id="spatialCoverage-error" aria-live="polite"></p></fieldset></div></div><div class="border-t border-neutral-200 px-4 py-3"><fieldset class="field field-group" id="decision.spatialCoverage"><legend class="field-label">Spatial coverage — decision</legend><div class="field-choices field-choices-inline"><label class="field-choice" for="decision.spatialCoverage-0"><input class="field-choice-input" type="radio" id="decision.spatialCoverage-0" name="decision.spatialCoverage" value="accept"><span class="field-choice-label">Accept</span></label><label class="field-choice" for="decision.spatialCoverage-1"><input class="field-choice-input" type="radio" id="decision.spatialCoverage-1" name="decision.spatialCoverage" value="revert"><span class="field-choice-label">Revert</span></label><label class="field-choice" for="decision.spatialCoverage-2"><input class="field-choice-input" type="radio" id="decision.spatialCoverage-2" name="decision.spatialCoverage" value="" checked><span class="field-choice-label">Not reviewed yet</span></label></div><p class="field-error" id="decision.spatialCoverage-error" aria-live="polite"></p></fieldset></div></div><div class="rounded border border-neutral-300 bg-white"><div class="flex flex-wrap items-center gap-3 border-b border-neutral-200 px-4 py-2"><strong>Contributors</strong><span class="badge badge-warning badge-md">Needs review</span></div><div class="grid gap-4 border-t border-neutral-200 p-4 md:grid-cols-2"><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Published</p><p class="text-neutral-900">5 entries</p></div><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Submitted</p><fieldset class="field field-group" id="attributions" aria-describedby="attributions-hint"><legend class="field-label">Contributors <span class="w-fit rounded bg-warning-50 px-2 py-0.5 text-xs font-bold text-warning-800">Required</span></legend><input type="hidden" name="attributions.row" value=""><button class="btn btn-secondary repeatable-add" type="submit" formaction="/attributions/add" formmethod="post">Add</button><p class="field-hint" id="attributions-hint">The people and organisations involved, each with their role or roles.</p><p class="field-error" id="attributions-error" aria-live="polite"></p></fieldset></div></div><div class="border-t border-neutral-200 px-4 py-3"><fieldset class="field field-group" id="decision.attributions"><legend class="field-label">Contributors — decision</legend><div class="field-choices field-choices-inline"><label class="field-choice" for="decision.attributions-0"><input class="field-choice-input" type="radio" id="decision.attributions-0" name="decision.attributions" value="accept"><span class="field-choice-label">Accept</span></label><label class="field-choice" for="decision.attributions-1"><input class="field-choice-input" type="radio" id="decision.attributions-1" name="decision.attributions" value="revert"><span class="field-choice-label">Revert</span></label><label class="field-choice" for="decision.attributions-2"><input class="field-choice-input" type="radio" id="decision.attributions-2" name="decision.attributions" value="" checked><span class="field-choice-label">Not reviewed yet</span></label></div><p class="field-error" id="decision.attributions-error" aria-live="polite"></p></fieldset></div></div><div class="rounded border border-neutral-300 bg-white"><div class="flex flex-wrap items-center gap-3 border-b border-neutral-200 px-4 py-2"><strong>Abstract</strong><span class="badge badge-warning badge-md">Needs review</span></div><div class="grid gap-4 border-t border-neutral-200 p-4 md:grid-cols-2"><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Published</p><dl class="grid grid-cols-[6rem_1fr] gap-x-3 gap-y-1"><dt class="text-sm font-bold text-neutral-600">English</dt><dd class="whitespace-pre-line text-neutral-900">The interdisciplinary research project &quot;The image sequences of Basel's early prints: Late Medieval didactic didactics as an image-text reading&quot; combines a comprehensive art scholarly analysis of the links between images and texts in the illustrated incunabula in Basel with the digitization of the holdings of the University Library and the development of an electronic edition in the form of a new kind of Web-0.2 application. The project is carried out by Kunsthistorische Seminar of the University of Basel (Prof. B. Schellewald) and Digital Humanities Lab of the University of Basel (Prof. Dr. L. Rosenthaler).  The core of the digital edition consists of around twenty richly illustrated early prints from four different Basel officers. Many of them appeared in several editions before 1500, some of them in German and Latin at almost the same time. It is an extraordinarily varied production; in addition to the Mirror of Salvation, there is a novel, the Melusine, the travelogues of Jean de Mandeville, some prayer and edification books, theological writings, Lent sermons, the lives of Saints Fridolin and Meinrad, the famous ship of fools and the knight of Thurn.  The Internet publication makes the digitized corpus of these early prints usable for the scientific edition as well as for the exploration of images and texts through the possibilities of non-linear linking and commenting on the images and texts. Existing and emerging online editions can also be linked to it, which optimises the use of databases from other institutions with regard to our corpus.</dd></dl></div><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Submitted</p><fieldset class="field field-group" id="abstract" aria-describedby="abstract-hint"><legend class="field-label">Abstract <span class="w-fit rounded bg-info-50 px-2 py-0.5 text-xs font-bold text-info-800">Recommended</span></legend><div class="flex flex-col gap-3"><div class="field"><label class="field-label" for="abstract.de">German</label><textarea class="field-input field-textarea" id="abstract.de" name="abstract.de" rows="2"></textarea><p class="field-error" id="abstract.de-error" aria-live="polite"></p></div><div class="field"><label class="field-label" for="abstract.en">English</label><textarea class="field-input field-textarea" id="abstract.en" name="abstract.en" rows="2"></textarea><p class="field-error" id="abstract.en-error" aria-live="polite"></p></div><div class="field"><label class="field-label" for="abstract.fr">French</label><textarea class="field-input field-textarea" id="abstract.fr" name="abstract.fr" rows="2"></textarea><p class="field-error" id="abstract.fr-error" aria-live="polite"></p></div><div class="field"><label class="field-label" for="abstract.it">Italian</label><textarea class="field-input field-textarea" id="abstract.it" name="abstract.it" rows="2"></textarea><p class="field-error" id="abstract.it-error" aria-live="polite"></p></div></div><p class="field-hint" id="abstract-hint">Short, citation-ready summary.</p></fieldset></div></div><div class="border-t border-neutral-200 px-4 py-3"><fieldset class="field field-group" id="decision.abstract"><legend class="field-label">Abstract — decision</legend><div class="field-choices field-choices-inline"><label class="field-choice" for="decision.abstract-0"><input class="field-choice-input" type="radio" id="decision.abstract-0" name="decision.abstract" value="accept"><span class="field-choice-label">Accept</span></label><label class="field-choice" for="decision.abstract-1"><input class="field-choice-input" type="radio" id="decision.abstract-1" name="decision.abstract" value="revert"><span class="field-choice-label">Revert</span></label><label class="field-choice" for="decision.abstract-2"><input class="field-choice-input" type="radio" id="decision.abstract-2" name="decision.abstract" value="" checked><span class="field-choice-label">Not reviewed yet</span></label></div><p class="field-error" id="decision.abstract-error" aria-live="polite"></p></fieldset></div></div><div class="rounded border border-neutral-300 bg-white"><div class="flex flex-wrap items-center gap-3 border-b border-neutral-200 px-4 py-2"><strong>Contact point</strong><span class="badge badge-warning badge-md">Needs review</span></div><div class="grid gap-4 border-t border-neutral-200 p-4 md:grid-cols-2"><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Published</p><p class="text-neutral-900">1 entry</p></div><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Submitted</p><fieldset class="field field-group" id="contactPoint" aria-describedby="contactPoint-hint"><legend class="field-label">Contact point <span class="w-fit rounded bg-info-50 px-2 py-0.5 text-xs font-bold text-info-800">Recommended</span></legend><input type="hidden" name="contactPoint.row" value=""><button class="btn btn-secondary repeatable-add" type="submit" formaction="/contactPoint/add" formmethod="post">Add</button><p class="field-hint" id="contactPoint-hint">A person or organisation users should contact about the data. Needed before the project can be published.</p><p class="field-error" id="contactPoint-error" aria-live="polite"></p></fieldset></div></div><div class="border-t border-neutral-200 px-4 py-3"><fieldset class="field field-group" id="decision.contactPoint"><legend class="field-label">Contact point — decision</legend><div class="field-choices field-choices-inline"><label class="field-choice" for="decision.contactPoint-0"><input class="field-choice-input" type="radio" id="decision.contactPoint-0" name="decision.contactPoint" value="accept"><span class="field-choice-label">Accept</span></label><label class="field-choice" for="decision.contactPoint-1"><input class="field-choice-input" type="radio" id="decision.contactPoint-1" name="decision.contactPoint" value="revert"><span class="field-choice-label">Revert</span></label><label class="field-choice" for="decision.contactPoint-2"><input class="field-choice-input" type="radio" id="decision.contactPoint-2" name="decision.contactPoint" value="" checked><span class="field-choice-label">Not reviewed yet</span></label></div><p class="field-error" id="decision.contactPoint-error" aria-live="polite"></p></fieldset></div></div><div class="rounded border border-neutral-300 bg-white"><div class="flex flex-wrap items-center gap-3 border-b border-neutral-200 px-4 py-2"><strong>Publications</strong><span class="badge badge-warning badge-md">Needs review</span></div><div class="grid gap-4 border-t border-neutral-200 p-4 md:grid-cols-2"><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Published</p><p class="text-neutral-900">10 entries</p></div><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Submitted</p><fieldset class="field field-group" id="publications" aria-describedby="publications-hint"><legend class="field-label">Publications <span class="w-fit rounded bg-neutral-100 px-2 py-0.5 text-xs font-bold text-neutral-700">Optional</span></legend><input type="hidden" name="publications.row" value=""><button class="btn btn-secondary repeatable-add" type="submit" formaction="/publications/add" formmethod="post">Add</button><p class="field-hint" id="publications-hint">Bibliographic references, each with an optional persistent identifier.</p><p class="field-error" id="publications-error" aria-live="polite"></p></fieldset></div></div><div class="border-t border-neutral-200 px-4 py-3"><fieldset class="field field-group" id="decision.publications"><legend class="field-label">Publications — decision</legend><div class="field-choices field-choices-inline"><label class="field-choice" for="decision.publications-0"><input class="field-choice-input" type="radio" id="decision.publications-0" name="decision.publications" value="accept"><span class="field-choice-label">Accept</span></label><label class="field-choice" for="decision.publications-1"><input class="field-choice-input" type="radio" id="decision.publications-1" name="decision.publications" value="revert"><span class="field-choice-label">Revert</span></label><label class="field-choice" for="decision.publications-2"><input class="field-choice-input" type="radio" id="decision.publications-2" name="decision.publications" value="" checked><span class="field-choice-label">Not reviewed yet</span></label></div><p class="field-error" id="decision.publications-error" aria-live="polite"></p></fieldset></div></div><div class="rounded border border-neutral-300 bg-white"><div class="flex flex-wrap items-center gap-3 border-b border-neutral-200 px-4 py-2"><strong>Funding</strong><span class="badge badge-warning badge-md">Needs review</span></div><div class="grid gap-4 border-t border-neutral-200 p-4 md:grid-cols-2"><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Published</p><p class="text-neutral-900">1 entry</p></div><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Submitted</p><div class="field field-group"><fieldset class="field field-group" id="funding.kind" aria-describedby="funding.kind-hint"><legend class="field-label">How funding is recorded</legend><div class="field-choices field-choices-inline"><label class="field-choice" for="funding.kind-0"><input class="field-choice-input" type="radio" id="funding.kind-0" name="funding.kind" value="grants" checked><span class="field-choice-label">Grants</span></label><label class="field-choice" for="funding.kind-1"><input class="field-choice-input" type="radio" id="funding.kind-1" name="funding.kind" value="text"><span class="field-choice-label">A note instead</span></label></div><p class="field-hint" id="funding.kind-hint">Grants are listed one by one, each with its funder. A note is a single line, for a project with nothing to list. Switching saves the form, and neither is lost.</p><p class="field-error" id="funding.kind-error" aria-live="polite"></p></fieldset><div><fieldset class="field field-group" id="funding" aria-describedby="funding-hint"><legend class="field-label">Funding <span class="w-fit rounded bg-warning-50 px-2 py-0.5 text-xs font-bold text-warning-800">Required</span></legend><input type="hidden" name="funding.row" value=""><button class="btn btn-secondary repeatable-add" type="submit" formaction="/funding/add" formmethod="post">Add</button><p class="field-hint" id="funding-hint">At least one funder — funder organisation or organisations, plus grant number, programme and URL.</p><p class="field-error" id="funding-error" aria-live="polite"></p></fieldset></div><div hidden><div class="field"><label class="field-label" for="funding.text">Funding note</label><input class="field-input" id="funding.text" name="funding.text" type="text" value="" aria-describedby="funding.text-hint"><p class="field-hint" id="funding.text-hint">For example, &quot;No funding&quot;.</p><p class="field-error" id="funding.text-error" aria-live="polite"></p></div></div></div></div></div><div class="border-t border-neutral-200 px-4 py-3"><fieldset class="field field-group" id="decision.funding"><legend class="field-label">Funding — decision</legend><div class="field-choices field-choices-inline"><label class="field-choice" for="decision.funding-0"><input class="field-choice-input" type="radio" id="decision.funding-0" name="decision.funding" value="accept"><span class="field-choice-label">Accept</span></label><label class="field-choice" for="decision.funding-1"><input class="field-choice-input" type="radio" id="decision.funding-1" name="decision.funding" value="revert"><span class="field-choice-label">Revert</span></label><label class="field-choice" for="decision.funding-2"><input class="field-choice-input" type="radio" id="decision.funding-2" name="decision.funding" value="" checked><span class="field-choice-label">Not reviewed yet</span></label></div><p class="field-error" id="decision.funding-error" aria-live="polite"></p></fieldset></div></div><div class="rounded border border-neutral-300 bg-white"><div class="flex flex-wrap items-center gap-3 border-b border-neutral-200 px-4 py-2"><strong>Alternative names</strong><span class="badge badge-warning badge-md">Needs review</span></div><div class="grid gap-4 border-t border-neutral-200 p-4 md:grid-cols-2"><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Published</p><p class="text-neutral-900">1 entry</p></div><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Submitted</p><fieldset class="field field-group" id="alternativeNames" aria-describedby="alternativeNames-hint"><legend class="field-label">Alternative names <span class="w-fit rounded bg-neutral-100 px-2 py-0.5 text-xs font-bold text-neutral-700">Optional</span></legend><input type="hidden" name="alternativeNames.row" value=""><button class="btn btn-secondary repeatable-add" type="submit" formaction="/alternativeNames/add" formmethod="post">Add</button><p class="field-hint" id="alternativeNames-hint">Acronyms or alternate spellings — one value per language.</p><p class="field-error" id="alternativeNames-error" aria-live="polite"></p></fieldset></div></div><div class="border-t border-neutral-200 px-4 py-3"><fieldset class="field field-group" id="decision.alternativeNames"><legend class="field-label">Alternative names — decision</legend><div class="field-choices field-choices-inline"><label class="field-choice" for="decision.alternativeNames-0"><input class="field-choice-input" type="radio" id="decision.alternativeNames-0" name="decision.alternativeNames" value="accept"><span class="field-choice-label">Accept</span></label><label class="field-choice" for="decision.alternativeNames-1"><input class="field-choice-input" type="radio" id="decision.alternativeNames-1" name="decision.alternativeNames" value="revert"><span class="field-choice-label">Revert</span></label><label class="field-choice" for="decision.alternativeNames-2"><input class="field-choice-input" type="radio" id="decision.alternativeNames-2" name="decision.alternativeNames" value="" checked><span class="field-choice-label">Not reviewed yet</span></label></div><p class="field-error" id="decision.alternativeNames-error" aria-live="polite"></p></fieldset></div></div><div class="rounded border border-neutral-300 bg-white"><div class="flex flex-wrap items-center gap-3 border-b border-neutral-200 px-4 py-2"><strong>Project image credit</strong><span class="badge badge-warning badge-md">Needs review</span></div><div class="grid gap-4 border-t border-neutral-200 p-4 md:grid-cols-2"><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Published</p><p class="whitespace-pre-line text-neutral-900">Sebastian Brant, Stultifera navis, Basel: Johann Bergmann von Olpe, 1. März 1497, Titelblatt (Detail). Universitätsbibliothek Basel, Ai II 22a. CC BY 4.0.</p></div><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Submitted</p><div class="field"><label class="field-label" for="imageCredit">Project image credit <span class="w-fit rounded bg-neutral-100 px-2 py-0.5 text-xs font-bold text-neutral-700">Optional</span></label><textarea class="field-input field-textarea" id="imageCredit" name="imageCredit" rows="3" aria-describedby="imageCredit-hint"></textarea><p class="field-hint" id="imageCredit-hint">Who the project image belongs to and on what terms it may be shown — a licence and a copyright holder at minimum. The licence governs the image, separately from the dataset licence.</p><p class="field-error" id="imageCredit-error" aria-live="polite"></p></div></div></div><div class="border-t border-neutral-200 px-4 py-3"><fieldset class="field field-group" id="decision.imageCredit"><legend class="field-label">Project image credit — decision</legend><div class="field-choices field-choices-inline"><label class="field-choice" for="decision.imageCredit-0"><input class="field-choice-input" type="radio" id="decision.imageCredit-0" name="decision.imageCredit" value="accept"><span class="field-choice-label">Accept</span></label><label class="field-choice" for="decision.imageCredit-1"><input class="field-choice-input" type="radio" id="decision.imageCredit-1" name="decision.imageCredit" value="revert"><span class="field-choice-label">Revert</span></label><label class="field-choice" for="decision.imageCredit-2"><input class="field-choice-input" type="radio" id="decision.imageCredit-2" name="decision.imageCredit" value="" checked><span class="field-choice-label">Not reviewed yet</span></label></div><p class="field-error" id="decision.imageCredit-error" aria-live="polite"></p></fieldset></div></div><div class="flex flex-wrap items-center gap-4 mt-2"><button class="btn btn-primary" type="submit" name="intent" value="save">Save review decisions</button><button class="btn btn-secondary" type="submit" name="intent" value="accept-all">Accept all remaining</button></div><div class="mt-8 flex flex-col gap-4"><h2 class="font-display text-xl">Proposed people and organisations</h2><div class="rounded border border-neutral-300 bg-white"><div class="flex flex-wrap items-center gap-3 border-b border-neutral-200 px-4 py-2"><strong>Person person-417</strong><span class="badge badge-secondary badge-md">New</span></div><div class="border-t border-neutral-200 px-4 