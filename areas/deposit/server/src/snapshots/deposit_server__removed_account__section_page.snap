<main class="flex-1 max-w-[1536px] mx-auto px-4 w-full"><div class="max-w-5xl py-8"><div class="mb-6"><h1 class="font-display text-2xl mb-1">Basler Edition der Bernoulli-Briefwechsel</h1><p class="font-mono text-sm text-gray-600">0801d</p><p class="mt-2"><a href="/projects" class="underline">Back to your projects</a></p></div><section id="project-section" class="grid gap-6 md:grid-cols-[16rem_1fr] items-start"><nav class="md:sticky md:top-4" aria-label="Form sections"><ol class="flex flex-col gap-1"><li><a href="/projects/0801d/sections/overview" class="flex flex-col rounded bg-neutral-100 px-3 py-2 font-bold focus-visible:outline-2 focus-visible:outline-primary-600" aria-current="page" aria-label="Overview, 0 of 5 required"><span>Overview</span><span class="text-xs text-neutral-600">0 of 5 required</span></a></li><li><a href="/projects/0801d/sections/dataset" class="flex flex-col rounded px-3 py-2 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-primary-600" aria-label="Dataset, 0 of 4 required"><span>Dataset</span><span class="text-xs text-neutral-600">0 of 4 required</span></a></li><li><a href="/projects/0801d/sections/publications" class="flex flex-col rounded px-3 py-2 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-primary-600"><span>Publications</span></a></li><li><a href="/projects/0801d/sections/contributors" class="flex flex-col rounded px-3 py-2 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-primary-600" aria-label="Contributors, 0 of 1 required"><span>Contributors</span><span class="text-xs text-neutral-600">0 of 1 required</span></a></li><li><a href="/projects/0801d/sections/access" class="flex flex-col rounded px-3 py-2 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-primary-600" aria-label="Access, citation and funding, 0 of 2 required"><span>Access, citation and funding</span><span class="text-xs text-neutral-600">0 of 2 required</span></a></li><li><a href="/projects/0801d/sections/image" class="flex flex-col rounded px-3 py-2 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-primary-600"><span>Project image</span></a></li></ol></nav><div><div class="empty:hidden sticky top-0 z-10" aria-live="polite"></div><div class="alert alert-info"><p class="alert-title">RDU asked for changes</p><p>This project is a draft again. Fields RDU accepted are fixed until you submit it again; everything else is yours to edit.</p><p class="text-sm mt-2">2026-09-08 10:00 UTC</p><div class="mt-3"><p class="text-xs font-bold uppercase tracking-wide">What RDU wrote</p><p class="whitespace-pre-line">Please add a German description.</p></div></div><h2 class="font-display text-xl mb-4">Overview</h2><form id="section-form" method="post" action="/projects/0801d/sections/overview" class="flex flex-col gap-6" data-on:submit="@post(evt.submitter?.formAction || '/projects/0801d/sections/overview', {contentType: 'form'})" data-on:change__debounce.1s="@post('/projects/0801d/sections/overview', {contentType: 'form'})"><input type="hidden" name="baseline" value="2026-09-08T10:00:00+00:00"><div class="field"><p class="field-label">PID</p><p class="italic text-neutral-600">Not set</p><p class="field-hint">The project's persistent identifier. Assigned by DaSCH on first publication.</p></div><div class="field"><label class="field-label" for="name">Name <span class="w-fit rounded bg-warning-50 px-2 py-0.5 text-xs font-bold text-warning-800">Required</span></label><input class="field-input" id="name" name="name" type="text" value="" aria-describedby="name-hint"><p class="field-hint" id="name-hint">Full, human-readable project title.</p><p class="field-error" id="name-error" aria-live="polite"></p></div><div class="field"><label class="field-label" for="officialName">Official name <span class="w-fit rounded bg-info-50 px-2 py-0.5 text-xs font-bold text-info-800">Recommended</span></label><input class="field-input" id="officialName" name="officialName" type="text" value="" aria-describedby="officialName-hint"><p class="field-hint" id="officialName-hint">Official legal name of the project — the formal registered title, for example as filed with the funder. Kept for records, and not shown on the public project page.</p><p class="field-error" id="officialName-error" aria-live="polite"></p></div><fieldset class="field field-group" id="alternativeNames" aria-describedby="alternativeNames-hint"><legend class="field-label">Alternative names <span class="w-fit rounded bg-neutral-100 px-2 py-0.5 text-xs font-bold text-neutral-700">Optional</span></legend><input type="hidden" name="alternativeNames.row" value=""><button class="btn btn-secondary repeatable-add" type="submit" formaction="/projects/0801d/sections/overview/fields/alternativeNames/add" formmethod="post">Add</button><p class="field-hint" id="alternativeNames-hint">Acronyms or alternate spellings — one value per language.</p><p class="field-error" id="alternativeNames-error" aria-live="polite"></p></fieldset><div class="field"><label class="field-label" for="shortDescription">Short description <span class="w-fit rounded bg-warning-50 px-2 py-0.5 text-xs font-bold text-warning-800">Required</span></label><textarea class="field-input field-textarea" id="shortDescription" name="shortDescription" rows="2" maxlength="200" aria-describedby="shortDescription-hint"></textarea><p class="field-hint" id="shortDescription-hint">One-line teaser for cards and listings. Up to 200 characters.</p><p class="field-error" id="shortDescription-error" aria-live="polite"></p></div><fieldset class="field field-group" id="description" aria-describedby="description-hint"><legend class="field-label">Description <span class="w-fit rounded bg-warning-50 px-2 py-0.5 text-xs font-bold text-warning-800">Required</span></legend><div class="flex flex-col gap-3"><div class="field"><label class="field-label" for="description.de">German</label><textarea class="field-input field-textarea" id="description.de" name="description.de" rows="5"></textarea><p class="field-error" id="description.de-error" aria-live="polite"></p></div><div class="field"><label class="field-label" for="description.en">English</label><textarea class="field-input field-textarea" id="description.en" name="description.en" rows="5"></textarea><p class="field-error" id="description.en-error" aria-live="polite"></p></div><div class="field"><label class="field-label" for="description.fr">French</label><textarea class="field-input field-textarea" id="description.fr" name="description.fr" rows="5"></textarea><p class="field-error" id="description.fr-error" aria-live="polite"></p></div><div class="field"><label class="field-label" for="description.it">Italian</label><textarea class="field-input field-textarea" id="description.it" name="description.it" rows="5"></textarea><p class="field-error" id="description.it-error" aria-live="polite"></p></div></div><p class="field-hint" id="description-hint">Long form — at least one language.</p></fieldset><fieldset class="field field-group" id="abstract" aria-describedby="abstract-hint"><legend class="field-label">Abstract <span class="w-fit rounded bg-info-50 px-2 py-0.5 text-xs font-bold text-info-800">Recommended</span></legend><div class="flex flex-col gap-3"><div class="field"><label class="field-label" for="abstract.de">German</label><textarea class="field-input field-textarea" id="abstract.de" name="abstract.de" rows="2"></textarea><p class="field-error" id="abstract.de-error" aria-live="polite"></p></div><div class="field"><label class="field-label" for="abstract.en">English</label><textarea class="field-input field-textarea" id="abstract.en" name="abstract.en" rows="2"></textarea><p class="field-error" id="abstract.en-error" aria-live="polite"></p></div><div class="field"><label class="field-label" for="abstract.fr">French</label><textarea class="field-input field-textarea" id="abstract.fr" name="abstract.fr" rows="2"></textarea><p class="field-error" id="abstract.fr-error" aria-live="polite"></p></div><div class="field"><label class="field-label" for="abstract.it">Italian</label><textarea class="field-input field-textarea" id="abstract.it" name="abstract.it" rows="2"></textarea><p class="field-error" id="abstract.it-error" aria-live="polite"></p></div></div><p class="field-hint" id="abstract-hint">Short, citation-ready summary.</p></fieldset><div class="field"><label class="field-label" for="secondaryUrl">External project website <span class="w-fit rounded bg-neutral-100 px-2 py-0.5 text-xs font-bold text-neutral-700">Optional</span></label><input class="field-input" id="secondaryUrl" name="secondaryUrl" type="text" value="" aria-describedby="secondaryUrl-hint"><p class="field-hint" id="secondaryUrl-hint">The project's own website outside DaSCH, if it has one.</p><p class="field-error" id="secondaryUrl-error" aria-live="polite"></p></div><fieldset class="field field-group" id="status" aria-describedby="status-hint"><legend class="field-label">Status <span class="w-fit rounded bg-warning-50 px-2 py-0.5 text-xs font-bold text-warning-800">Required</span></legend><div class="field-choices field-choices-inline"><label class="field-choice" for="status-0"><input class="field-choice-input" type="radio" id="status-0" name="status" value="Ongoing"><span class="field-choice-label">Ongoing</span></label><label class="field-choice" for="status-1"><input class="field-choice-input" type="radio" id="status-1" name="status" value="Finished"><span class="field-choice-label">Finished</span></label></div><p class="field-hint" id="status-hint">Whether the project is ongoing or finished.</p><p class="field-error" id="status-error" aria-live="polite"></p></fieldset><div class="field"><label class="field-label" for="startDate">Start date <span class="w-fit rounded bg-warning-50 px-2 py-0.5 text-xs font-bold text-warning-800">Required</span></label><input class="field-input" id="startDate" name="startDate" type="date" value="" aria-describedby="startDate-hint"><p class="field-hint" id="startDate-hint">When the project began.</p><p class="field-error" id="startDate-error" aria-live="polite"></p></div><div class="field"><label class="field-label" for="endDate">End date <span class="w-fit rounded bg-neutral-100 px-2 py-0.5 text-xs font-bold text-neutral-700">Optional</span></label><input class="field-input" id="endDate" name="endDate" type="date" value="" aria-describedby="endDate-hint"><p class="field-hint" id="endDate-hint">Leave empty while the project is ongoing.</p><p class="field-error" id="endDate-error" aria-live="polite"></p></div><div class="flex flex-wrap items-center gap-4"><button class="btn btn-secondary" type="submit" name="intent" value="save">Save draft</button><button class="btn btn-primary" type="submit" name="intent" value="submit">Submit for review</button><button class="btn btn-secondary" type="submit" name="intent" value="discard-confirm">Discard draft</button><p class="text-sm text-gray-600">Draft last saved 2026-09-08 10:00 UTC.</p></div></form></div></section></div></main>
