load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The VRE bridge's pure logic: no network, and no file system but the shipped inputs it digests.
# Only vre-bridge-server links it (areas/deposit/ADR-0005).
rust_library(
    name = "vre_bridge_core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "vre_bridge_core",
    visibility = ["//areas/deposit/vre-bridge/server:__pkg__"],
    deps = [
        "//areas/deposit/vre-bridge/lift:vre_bridge_lift",
        "//shared/names:shared_names",
        "//shared/stand-in:shared_stand_in",
        "@crates//:chrono",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "vre_bridge_core_test",
    compile_data = glob(["testdata/datei/**"]),
    crate = ":vre_bridge_core",
    deps = ["@crates//:tempfile"],
)

# The synthetic DaTEI project `0001`'s shipped inputs, for vre-bridge-server's refresh tests.
filegroup(
    name = "datei_0001",
    testonly = True,
    srcs = glob(["testdata/datei/0001/**"]),
    visibility = ["//areas/deposit/vre-bridge/server:__pkg__"],
)
