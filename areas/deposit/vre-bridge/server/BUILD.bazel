load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The VRE bridge's entry crate (areas/deposit/ADR-0005): the bridge deposit-server starts, its
# nightly run and the operator's refresh, over the bridge's other four crates.
rust_library(
    name = "vre_bridge_server",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "vre_bridge_server",
    proc_macro_deps = ["@crates//:async-trait"],
    deps = [
        "//areas/deposit/vre-bridge/client:vre_bridge_client",
        "//areas/deposit/vre-bridge/core:vre_bridge_core",
        "//areas/deposit/vre-bridge/lift:vre_bridge_lift",
        "//areas/deposit/vre-bridge/store:vre_bridge_store",
        "//shared/stand-in:shared_stand_in",
        "@crates//:chrono",
        "@crates//:chrono-tz",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tracing",
    ],
)

# Runs against wiremock with real time: the client's test key pair, which no server trusts.
rust_test(
    name = "vre_bridge_server_test",
    compile_data = ["//areas/deposit/vre-bridge/client:testdata/ed25519-private.pem"],
    crate = ":vre_bridge_server",
    proc_macro_deps = ["@crates//:async-trait"],
    deps = [
        "@crates//:rustls",
        "@crates//:serde_json",
        "@crates//:tracing-subscriber",
        "@crates//:wiremock",
        "@crates//:zip",
    ],
)
