load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The VRE bridge's entry crate (areas/deposit/ADR-0005): the bridge deposit-server starts, its
# nightly run and the operator's refresh, over the bridge's other four crates. deposit-server is
# the only crate that links it.
rust_library(
    name = "vre_bridge_server",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "vre_bridge_server",
    proc_macro_deps = ["@crates//:async-trait"],
    visibility = ["//areas/deposit/server:__pkg__"],
    deps = [
        "//areas/deposit/vre-bridge/client:vre_bridge_client",
        "//areas/deposit/vre-bridge/core:vre_bridge_core",
        "//areas/deposit/vre-bridge/lift:vre_bridge_lift",
        "//areas/deposit/vre-bridge/store:vre_bridge_store",
        "//shared/stand-in:shared_stand_in",
        "@crates//:chrono",
        "@crates//:chrono-tz",
        "@crates//:opentelemetry",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tracing",
    ],
)

# Runs against wiremock with real time: the client's test key pair, which no server trusts.
rust_test(
    name = "vre_bridge_server_test",
    compile_data = ["//areas/deposit/vre-bridge/client:testdata/ed25519-private.pem"],
    crate = ":vre_bridge_server",
    proc_macro_deps = ["@crates//:async-trait"],
    deps = [
        "@crates//:opentelemetry_sdk",
        "@crates//:rustls",
        "@crates//:serde_json",
        "@crates//:tracing-subscriber",
        "@crates//:wiremock",
        "@crates//:zip",
    ],
)

# The inputs digest refuses a symbolic link, and runfiles are symbolic links, so the shipped inputs
# are read from a copy at their repository paths, below `test_inputs/`, and the test runs outside
# the local sandbox, which would link each copied file again.
copy_to_directory(
    name = "test_inputs",
    testonly = True,
    srcs = ["//areas/deposit/vre-bridge/inputs"],
    root_paths = [],
)

# A refresh of 0803 over its committed shipped inputs, through the public `VreBridge`.
rust_test(
    name = "refresh_0803_test",
    srcs = ["tests/refresh_0803.rs"],
    compile_data = ["//areas/deposit/vre-bridge/client:testdata/ed25519-private.pem"],
    data = [":test_inputs"],
    rustc_env = {"CARGO_MANIFEST_DIR": "areas/deposit/vre-bridge/server"},
    tags = ["no-sandbox"],
    deps = [
        ":vre_bridge_server",
        "//shared/stand-in:shared_stand_in",
        "@crates//:opentelemetry",
        "@crates//:rustls",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:wiremock",
        "@crates//:zip",
    ],
)
