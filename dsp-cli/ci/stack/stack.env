# Pin for the dsp-api / Fuseki images used by this stack.
# This is this repository's pin, chosen so dsp-cli's live tests run against a
# known dsp-api version. It is not a dsp-api release recommendation, and it
# is not kept in lockstep with dsp-api's own "latest"-based compose.
API=v39.0.0
DB=v38.1.0
