---
source: modules/editor/web/src/pages/review.rs
expression: region(&view).into_string()
---
<section id="review-surface"><div class="empty:hidden" aria-live="polite"><div class="alert alert-success mb-4">Review decisions saved.</div></div><div class="flex flex-wrap items-center gap-4 mb-4"><p class="text-sm text-neutral-700"><strong>1 accepted</strong> · <strong>1 to review</strong> of 2 changes</p><a href="/review/0801d?show=all" class="link ">Show every field</a></div><form id="review-form" method="post" action="/review/0801d" class="flex flex-col gap-4" data-on:submit="@post('/review/0801d', {contentType: 'form'})"><div class="rounded border border-neutral-300 bg-white"><div class="flex flex-wrap items-center gap-3 border-b border-neutral-200 px-4 py-2"><strong>Name</strong><span class="badge badge-success badge-md">Accepted</span></div><div class="grid gap-4 border-t border-neutral-200 p-4 md:grid-cols-2"><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Published</p><p class="whitespace-pre-line text-neutral-900">Old name</p></div><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Submitted</p><div class="field"><label class="field-label" for="name">Name <span class="w-fit rounded bg-warning-50 px-2 py-0.5 text-xs font-bold text-warning-800">Required</span></label><input class="field-input" id="name" name="name" type="text" value="New name" aria-describedby="name-hint"><p class="field-hint" id="name-hint">Full, human-readable project title.</p><p class="field-error" id="name-error" aria-live="polite"></p></div></div></div><div class="border-t border-neutral-200 px-4 py-3"><fieldset class="field field-group" id="decision.name"><legend class="field-label">Name — decision</legend><div class="field-choices field-choices-inline"><label class="field-choice" for="decision.name-0"><input class="field-choice-input" type="radio" id="decision.name-0" name="decision.name" value="accept" checked><span class="field-choice-label">Accept</span></label><label class="field-choice" for="decision.name-1"><input class="field-choice-input" type="radio" id="decision.name-1" name="decision.name" value="revert"><span class="field-choice-label">Revert</span></label><label class="field-choice" for="decision.name-2"><input class="field-choice-input" type="radio" id="decision.name-2" name="decision.name" value=""><span class="field-choice-label">Not reviewed yet</span></label></div><p class="field-error" id="decision.name-error" aria-live="polite"></p></fieldset></div></div><div class="rounded border border-neutral-300 bg-white"><div class="flex flex-wrap items-center gap-3 border-b border-neutral-200 px-4 py-2"><strong>Abstract</strong><span class="badge badge-warning badge-md">Needs review</span></div><div class="grid gap-4 border-t border-neutral-200 p-4 md:grid-cols-2"><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Published</p><dl class="grid grid-cols-[6rem_1fr] gap-x-3 gap-y-1"><dt class="text-sm font-bold text-neutral-600">English</dt><dd class="whitespace-pre-line text-neutral-900">An old abstract.</dd></dl></div><div><p class="mb-2 text-xs font-bold uppercase tracking-wide text-neutral-600">Submitted</p><fieldset class="field field-group" id="abstract" aria-describedby="abstract-hint"><legend class="field-label">Abstract <span class="w-fit rounded bg-info-50 px-2 py-0.5 text-xs font-bold text-info-800">Recommended</span></legend><div class="flex flex-col gap-3"><div class="field"><label class="field-label" for="abstract.de">German</label><textarea class="field-input field-textarea" id="abstract.de" name="abstract.de" rows="2">Ein neues Abstract.</textarea><p class="field-error" id="abstract.de-error" aria-live="polite"></p></div><div class="field"><label class="field-label" for="abstract.en">English</label><textarea class="field-input field-textarea" id="abstract.en" name="abstract.en" rows="2">A new abstract.</textarea><p class="field-error" id="abstract.en-error" aria-live="polite"></p></div><div class="field"><label class="field-label" for="abstract.fr">French</label><textarea class="field-input field-textarea" id="abstract.fr" name="abstract.fr" rows="2"></textarea><p class="field-error" id="abstract.fr-error" aria-live="polite"></p></div><div class="field"><label class="field-label" for="abstract.it">Italian</label><textarea class="field-input field-textarea" id="abstract.it" name="abstract.it" rows="2"></textarea><p class="field-error" id="abstract.it-error" aria-live="polite"></p></div></div><p class="field-hint" id="abstract-hint">Short, citation-ready summary.</p></fieldset></div></div><div class="border-t border-neutral-200 px-4 py-3"><fieldset class="field field-group" id="decision.abstract"><legend class="field-label">Abstract — decision</legend><div class="field-choices field-choices-inline"><label class="field-choice" for="decision.abstract-0"><input class="field-choice-input" type="radio" id="decision.abstract-0" name="decision.abstract" value="accept"><span class="field-choice-label">Accept</span></label><label class="field-choice" for="decision.abstract-1"><input class="field-choice-input" type="radio" id="decision.abstract-1" name="decision.abstract" value="revert"><span class="field-choice-label">Revert</span></label><label class="field-choice" for="decision.abstract-2"><input class="field-choice-input" type="radio" id="decision.abstract-2" name="decision.abstract" value="" checked><span class="field-choice-label">Not reviewed yet</span></label></div><p class="field-error" id="decision.abstract-error" aria-live="polite"></p></fieldset></div></div><div class="flex items-center gap-4 mt-2"><button class="btn btn-primary" type="submit" name="intent" value="save">Save review decisions</button><button class="btn btn-secondary" type="submit" name="intent" value="accept-all">Accept all remaining</button></div></form></section>
