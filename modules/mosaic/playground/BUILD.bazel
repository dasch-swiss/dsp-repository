load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//tools/image:defs.bzl", "MUSL", "app_image", "binary_layer", "files_layer")
load("//tools/tailwind:defs.bzl", "tailwind_css")

# The playground's static files. `just css-mosaic` writes the stylesheet into `public/assets/`,
# git-ignored; it stays out, or a stale build would reach the image.
filegroup(
    name = "public",
    srcs = glob(
        ["public/**"],
        exclude = ["public/assets/**"],
    ),
)

_SRCS = glob(["src/**/*.rs"])

# The stylesheet, a plain `app.css`, as `just css-mosaic` writes it. `srcs` holds what
# `style/main.css` imports and every file its `@source` lines scan.
tailwind_css(
    name = "css",
    src = "style/main.css",
    srcs = _SRCS + [
        "//modules/mosaic/tiles:stylesheets",
        "//modules/mosaic/tiles:tailwind_sources",
    ],
)

_DEPS = [
    "//modules/mosaic/tiles:mosaic_tiles",
    "@crates//:axum",
    "@crates//:maud",
    "@crates//:tokio",
    "@crates//:tower-http",
]

_DEV_DEPS = _DEPS + [
    "@crates//:notify",
    "@crates//:tower-livereload",
]

rust_binary(
    name = "mosaic_playground",
    srcs = _SRCS,
    crate_name = "mosaic_playground",
    deps = _DEPS,
)

# The `dev` feature: live reload for `just watch-mosaic-playground`.
rust_binary(
    name = "mosaic_playground_dev",
    srcs = _SRCS,
    crate_features = ["dev"],
    crate_name = "mosaic_playground",
    deps = _DEV_DEPS,
)

rust_test(
    name = "mosaic_playground_test",
    crate = ":mosaic_playground",
    deps = ["@crates//:tower"],
)

# `crate_features` is not inherited from `crate`.
rust_test(
    name = "mosaic_playground_dev_test",
    crate = ":mosaic_playground_dev",
    crate_features = ["dev"],
    deps = ["@crates//:tower"],
)

# ── The playground image, `daschswiss/mosaic-playground` ───────────────────
#
# A static musl binary on distroless `static` (`//tools/image:defs.bzl`), the same shape as the DPE
# and editor images, built with `--config=release` by `just build-docker-mosaic-playground` and pushed by
# the `docker-publish` action.
binary_layer(
    name = "image_binary",
    binary = ":mosaic_playground",
    path = "/app/mosaic-playground",
    target_compatible_with = MUSL,
)

files_layer(
    name = "image_public",
    srcs = [
        ":css",
        ":public",
    ],
    prefixes = {
        "modules/mosaic/playground/css": "app/public/assets",
        "modules/mosaic/playground/public": "app/public",
    },
    target_compatible_with = MUSL,
)

app_image(
    name = "image",
    repository = "index.docker.io/daschswiss/mosaic-playground",
    scan_tag = "local-scan/mosaic-playground:latest",
    entrypoint = ["/app/mosaic-playground"],
    env = {
        "MOSAIC_SITE_ADDR": "0.0.0.0:8080",
        "MOSAIC_PUBLIC_DIR": "/app/public",
    },
    exposed_ports = ["8080/tcp"],
    tars = [
        ":image_binary",
        ":image_public",
    ],
    workdir = "/app",
)
