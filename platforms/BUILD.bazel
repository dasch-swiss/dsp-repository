# Platform names follow Sipi's, so the copied `bazel-rbe` action works unchanged.
package(default_visibility = ["//visibility:public"])

# The CI runner and the remote worker. `cpu_arch` routes actions to the worker.
platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    exec_properties = {
        "cpu_arch": "x86_64",
    },
)

# The container images: static musl. `pie:off` because rustc links musl with `-no-pie`, while the
# toolchain defaults to `-static-pie`. Selected with `--platforms` by the image recipes.
platform(
    name = "linux_x86_64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@llvm//constraints/libc:musl",
        "@llvm//constraints/pie:off",
    ],
)

# Developers' machines.
platform(
    name = "darwin_aarch64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)
